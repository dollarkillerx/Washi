<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime for a .NET app that compiles code as it runs (JIT, not NativeAOT): it needs to write and run
     executable memory. Every bundled dylib (PDFium, SkiaSharp, HarfBuzz) is signed with the same Developer ID by vpk;
     library validation is relaxed only so the .NET host can load them. Not sandboxed (it opens and saves PDFs anywhere
     the user picks, and runs tesseract / swiftc for OCR). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
