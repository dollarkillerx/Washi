<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the .exe's own icon on Windows (16–256 px) -->
    <ApplicationIcon>../../assets/brand/washi.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Washi.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- install and auto-update from the GitHub releases (as in MySSH); the vpk CLI used by tools/release must be the same version -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Washi.Ai\Washi.Ai.csproj" />
    <ProjectReference Include="..\Washi.McpHost\Washi.McpHost.csproj" />
    <!-- built, not referenced: the washi-mcp stdio bridge (Claude Desktop) is copied to mcp/ below -->
    <ProjectReference Include="..\Washi.Mcp\Washi.Mcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- washi-mcp in its own folder (bin/.../mcp/) so `dotnet run` shows the Claude Desktop setup too.
       build/macos/bundle.sh publishes it to Contents/MacOS/mcp/ the same way. -->
  <Target Name="CopyMcpBridge" AfterTargets="Build">
    <MSBuild Projects="..\Washi.Mcp\Washi.Mcp.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_McpBridgeTarget" />
    </MSBuild>
    <PropertyGroup>
      <_McpBridgeDir>@(_McpBridgeTarget->'%(RootDir)%(Directory)')</_McpBridgeDir>
    </PropertyGroup>
    <ItemGroup>
      <_McpBridgeFiles Include="$(_McpBridgeDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_McpBridgeFiles)" DestinationFiles="@(_McpBridgeFiles->'$(OutDir)mcp\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
