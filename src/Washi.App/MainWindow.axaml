<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Washi.App.ViewModels"
        xmlns:c="using:Washi.App.Controls"
        xmlns:l="using:Washi.App.Localization"
        x:Class="Washi.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/washi.ico"
        Width="1360" Height="860" MinWidth="900" MinHeight="560">

    <Window.Styles>
        <Style Selector="Button, ToggleButton">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6f6f6f" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style Selector="Rectangle.sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Fill" Value="#d0d0d0" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Background="#fafafa">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" IsEnabled="{Binding HasDocument}">
                    <Button Content="◀" Command="{Binding PreviousPageCommand}" />
                    <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" MinWidth="90" TextAlignment="Center" />
                    <Button Content="▶" Command="{Binding NextPageCommand}" />
                    <Rectangle Classes="sep" />
                    <Button Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{l:Tr Ui_Zoom}" />
                    <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" />
                    <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="{l:Tr Ui_Zoom}" />
                </StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="{l:Tr Ui_Open}" Command="{Binding OpenCommand}" Margin="0,0,4,0" />
                    <Button Content="{l:Tr Ui_Detect}" Command="{Binding DetectCommand}" IsEnabled="{Binding HasDocument}" Margin="0,0,4,0" />
                    <Button Content="{l:Tr Ui_AiName}" Command="{Binding NameWithAiCommand}" IsEnabled="{Binding HasDocument}" Margin="0,0,4,0" />
                    <Rectangle Classes="sep" />
                    <ToggleButton Content="{l:Tr Ui_Draw}" IsChecked="{Binding DrawMode}" IsEnabled="{Binding HasDocument}" Margin="0,0,4,0" />
                    <Button Content="{l:Tr Ui_Delete}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,4,0" />
                    <Rectangle Classes="sep" />
                    <Button Content="{l:Tr Ui_LoadFields}" Command="{Binding LoadFieldsCommand}" IsEnabled="{Binding HasDocument}" Margin="0,0,4,0" />
                    <Button Content="{l:Tr Ui_SaveFields}" Command="{Binding SaveFieldsCommand}" IsEnabled="{Binding HasDocument}" Margin="0,0,4,0" />
                    <Rectangle Classes="sep" />
                    <TextBlock Text="{l:Tr Ui_FormLanguage}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.Languages}" SelectedItem="{Binding FormLanguage}"
                              VerticalAlignment="Center" MinWidth="120" Margin="0,0,8,0" />
                    <Button Content="{l:Tr Ui_EmbedFont}" Command="{Binding ChooseFontCommand}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding FontText}" VerticalAlignment="Center" Foreground="#6f6f6f" MaxWidth="180"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <Button Classes="accent" Content="{l:Tr Ui_MakeFillable}" Command="{Binding MakeFillableCommand}"
                            IsEnabled="{Binding HasDocument}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,5" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0" Background="#fafafa">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding Busy}" Width="120" Margin="10,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="#6f6f6f" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- side panel -->
        <Border DockPanel.Dock="Right" Width="320" BorderBrush="#e0e0e0" BorderThickness="1,0,0,0" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{l:Tr Ui_Field}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Tr Ui_NoSelection}" TextWrapping="Wrap" Foreground="#6f6f6f" Margin="0,8,0,0"
                               IsVisible="{Binding !HasSelection}" />
                    <StackPanel IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="caption" Text="{l:Tr Ui_Name}" />
                        <TextBox Text="{Binding SelectedField.Name}" />
                        <TextBlock Classes="caption" Text="{l:Tr Ui_Type}" />
                        <ComboBox x:Name="KindBox" ItemsSource="{x:Static vm:MainViewModel.Kinds}" HorizontalAlignment="Stretch"
                                  SelectedValue="{Binding SelectedField.Kind}" />
                        <StackPanel IsVisible="{Binding SelectedField.IsComb, FallbackValue=False}">
                            <TextBlock Classes="caption" Text="{l:Tr Ui_Boxes}" />
                            <NumericUpDown Value="{Binding SelectedField.MaxLen}" Minimum="1" Maximum="64" Increment="1" FormatString="0" />
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{l:Tr Ui_Align}" />
                        <ComboBox x:Name="AlignBox" ItemsSource="{x:Static vm:MainViewModel.Alignments}" HorizontalAlignment="Stretch"
                                  SelectedValue="{Binding SelectedField.Align}" />
                        <TextBlock Classes="caption" Text="{l:Tr Ui_Label}" />
                        <TextBlock Text="{Binding SelectedField.Label}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{l:Tr Ui_Prefilled}" />
                        <TextBlock Text="{Binding SelectedField.Prefilled}" TextWrapping="Wrap" Foreground="Crimson" />
                        <TextBlock Text="{Binding SelectedField.PositionText}" Foreground="#6f6f6f" FontSize="11" Margin="0,10,0,0" />
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{l:Tr Ui_FieldsOnPage}" Margin="0,18,0,4" />
                </StackPanel>
                <ListBox ItemsSource="{Binding PageFields}" SelectedItem="{Binding SelectedField}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldViewModel">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Foreground="#6f6f6f" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- page -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#e6e6e6">
            <Border Margin="28" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White"
                    BoxShadow="0 2 10 0 #33000000" IsVisible="{Binding HasDocument}">
                <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                    <c:FieldCanvas x:Name="Canvas" Editor="{Binding}" Zoom="{Binding Zoom}" />
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
