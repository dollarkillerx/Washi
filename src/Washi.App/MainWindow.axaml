<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Washi.App.ViewModels"
        xmlns:c="using:Washi.App.Controls"
        xmlns:l="using:Washi.App.Localization"
        xmlns:v="using:Washi.App.Views"
        xmlns:svc="using:Washi.App.Services"
        xmlns:print="using:Washi.Core.Printing"
        xmlns:sig="using:Washi.Core.Signatures"
        x:Class="Washi.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/washi.ico"
        DragDrop.AllowDrop="True"
        Width="1440" Height="900" MinWidth="980" MinHeight="600">

    <!--
      Layout after Acrobat: a dark header, a tool rail on the left with the tool's own panel next
      to it, the document in the middle with floating edit and page controls, and the Pages /
      Fields panels on the right. Each tool keeps its main action at the bottom of its panel.
    -->

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{l:Tr Ui_MenuFile}">
                <NativeMenu>
                    <NativeMenuItem Header="{l:Tr Ui_Open}" Command="{Binding OpenCommand}" Gesture="Cmd+O" />
                    <NativeMenuItem Header="{l:Tr Ui_MakeFillable}" Command="{Binding MakeFillableCommand}" Gesture="Cmd+S" />
                    <NativeMenuItem Header="{l:Tr Ui_PrintMenu}" Command="{Binding Print.OpenCommand}" Gesture="Cmd+P" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{l:Tr Ui_Close}" Command="{Binding CloseDocumentCommand}" Gesture="Cmd+W" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{l:Tr Ui_MenuView}">
                <NativeMenu>
                    <NativeMenuItem Header="{l:Tr Ui_ZoomIn}" Command="{Binding ZoomInCommand}" Gesture="Cmd+OemPlus" />
                    <NativeMenuItem Header="{l:Tr Ui_ZoomOut}" Command="{Binding ZoomOutCommand}" Gesture="Cmd+OemMinus" />
                    <NativeMenuItem Header="{l:Tr Ui_FitWidth}" Command="{Binding FitWidthCommand}" Gesture="Cmd+D0" />
                    <NativeMenuItem Header="{l:Tr Ui_FitPage}" Command="{Binding FitPageCommand}" Gesture="Cmd+D9" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{l:Tr Ui_FindMenu}" Command="{Binding Find.OpenCommand}" Gesture="Cmd+F" />
                    <NativeMenuItem Header="{l:Tr Ui_FindNext}" Command="{Binding Find.NextCommand}" Gesture="Cmd+G" />
                    <NativeMenuItem Header="{l:Tr Ui_FindPrevious}" Command="{Binding Find.PreviousCommand}" Gesture="Cmd+Shift+G" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{l:Tr Ui_PrevPage}" Command="{Binding PreviousPageCommand}" />
                    <NativeMenuItem Header="{l:Tr Ui_NextPage}" Command="{Binding NextPageCommand}" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>
        <!-- header (dark, like a Carbon UI shell) -->
        <Style Selector="Border.header Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#f4f4f4" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style Selector="Border.header Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Border.header Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#525252" />
        </Style>

        <!-- tool rail -->
        <Style Selector="RadioButton.rail">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bg" Background="Transparent" Height="60">
                        <Grid>
                            <Border Name="bar" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Foreground" Value="#393939" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="RadioButton.rail:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="#e8e8e8" />
        </Style>
        <Style Selector="RadioButton.rail:checked /template/ Border#bg">
            <Setter Property="Background" Value="#ffffff" />
        </Style>
        <Style Selector="RadioButton.rail:checked /template/ Border#bar">
            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
        </Style>
        <Style Selector="RadioButton.rail:checked">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
        </Style>
        <Style Selector="RadioButton.rail TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="68" />
        </Style>

        <!-- right rail -->
        <Style Selector="ToggleButton.siderail">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.siderail:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SelectedRailBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
        </Style>

        <!-- tool panels -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.lead">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- a full-width action with an icon on the left -->
        <Style Selector="Button.action">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.inserted">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="#da1e28" />
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- floating controls over the document -->
        <Style Selector="Border.float">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #33000000" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Border.float Button, Border.float ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.float ToggleButton:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SelectedRailBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- ============================================================ header -->
        <Border DockPanel.Dock="Top" Classes="header" Height="48" Background="{StaticResource InkBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,8,0" Spacing="10" VerticalAlignment="Center">
                    <!-- the Washi mark ("Sheet") -->
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="512" Height="512">
                            <Path Data="M0,0 H512 V512 H0 Z" Fill="{StaticResource WashiBlue}" />
                            <Path Data="M96,64 H320 L416,160 V448 H96 Z" Fill="White" />
                            <Path Data="M320,64 V160 H416 Z" Fill="#b1bff4" />
                            <Path Data="M144,224 h96 v80 h-96 Z M272,224 h96 v80 h-96 Z M144,336 h96 v80 h-96 Z" Fill="{StaticResource WashiBlue}" />
                            <Path Data="M272,336 h96 v80 h-96 Z" Fill="{StaticResource Vermilion}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Washi" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <Button DockPanel.Dock="Right" Click="OnSettingsClick" ToolTip.Tip="{l:Tr Ui_Settings}" Padding="14,0" x:Name="SettingsButton">
                    <c:Icon Data="{StaticResource I.Settings}" Size="18" />
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding Print.OpenCommand}" IsVisible="{Binding HasDocument}"
                        ToolTip.Tip="{l:Tr Ui_PrintMenu}" Padding="14,0" x:Name="PrintButton">
                    <c:Icon Data="{StaticResource I.Print}" Size="18" />
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding OpenCommand}" ToolTip.Tip="⌘O">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Data="{StaticResource I.Open}" Size="18" />
                        <TextBlock Text="{l:Tr Ui_Open}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- the open document, as a tab -->
                <Border IsVisible="{Binding HasDocument}" Background="#262626" Margin="8,0,0,0" HorizontalAlignment="Left"
                        BorderBrush="{StaticResource BlueBrush}" BorderThickness="0,2,0,0" MaxWidth="420">
                    <StackPanel Orientation="Horizontal" Margin="14,0,4,0" Spacing="6">
                        <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="340" ToolTip.Tip="{Binding PdfPath}" />
                        <Button Command="{Binding CloseDocumentCommand}" Width="32" Height="46" Padding="0"
                                HorizontalContentAlignment="Center" ToolTip.Tip="{l:Tr Ui_Close}">
                            <c:Icon Data="{StaticResource I.Close}" Size="14" />
                        </Button>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============================================================ status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,4" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource MistBrush}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding Busy}" Width="120" Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           VerticalAlignment="Center" IsVisible="{Binding ShowEditTools}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                           x:Name="StatusText" />
            </DockPanel>
        </Border>

        <!-- ============================================================ tool rail -->
        <Border DockPanel.Dock="Left" Width="76" Background="{StaticResource MistBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Settings sits at the bottom of the rail and opens as a page, not a window -->
                <RadioButton DockPanel.Dock="Bottom" Classes="rail" GroupName="tools" IsChecked="{Binding IsSettingsTool}" x:Name="SettingsToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Settings}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_Settings}" /></StackPanel>
                </RadioButton>
                <!-- the tools scroll when the window is too short for all of them -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" x:Name="RailScroller">
                <StackPanel>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsFormTool}" x:Name="FormToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Form}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolForm}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsOcrTool}" x:Name="OcrToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Ocr}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolOcr}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsCombineTool}" x:Name="CombineToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Combine}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolCombine}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsSplitTool}" x:Name="SplitToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Split}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolSplit}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsOrganizeTool}" x:Name="OrganizeToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Organize}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolOrganize}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsCompressTool}" x:Name="CompressToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Compress}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolCompress}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsCommentTool}" x:Name="CommentToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Comment}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolComment}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsSignTool}" x:Name="SignToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Sign}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolSign}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsProtectTool}" x:Name="ProtectToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Lock}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolProtect}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsRedactTool}" x:Name="RedactToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Redact}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolRedact}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsEditTextTool}" x:Name="EditTextToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.EditText}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolEditText}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsImagesTool}" x:Name="ImagesToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Image}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolImages}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsStampTool}" x:Name="StampToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Stamp}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolStamp}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsLinksTool}" x:Name="LinksToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Link}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolLinks}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsCompareTool}" x:Name="CompareToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Compare}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolCompare}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsEraseTool}" x:Name="EraseToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Erase}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolErase}" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="rail" GroupName="tools" IsChecked="{Binding IsAskTool}" x:Name="AskToolButton">
                    <StackPanel Spacing="4"><c:Icon Data="{StaticResource I.Ask}" HorizontalAlignment="Center" /><TextBlock Text="{l:Tr Ui_ToolAsk}" /></StackPanel>
                </RadioButton>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================================================ tool panel -->
        <Border DockPanel.Dock="Left" Width="{Binding ToolPanelWidth}" Background="White" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0"
                IsVisible="{Binding ShowToolPanel}">
            <Panel>
                <!-- Prepare form -->
                <DockPanel IsVisible="{Binding IsFormTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding MakeFillableCommand}" IsEnabled="{Binding HasDocument}"
                                    x:Name="MakeFillableButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Save}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_MakeFillable}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="⌘S" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_FormTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_FormLead}" />
                            <TextBlock Classes="note" Text="{Binding FieldSummary}" Margin="0,10,0,0" IsVisible="{Binding HasDocument}" />

                            <TextBlock Classes="section" Text="{l:Tr Ui_SectionFind}" />
                            <Button Classes="action" Command="{Binding DetectCommand}" IsEnabled="{Binding HasDocument}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <c:Icon Data="{StaticResource I.Detect}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_Detect}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="action" Command="{Binding NameWithAiCommand}" IsEnabled="{Binding HasDocument}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <c:Icon Data="{StaticResource I.Spark}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_AiName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="action" Command="{Binding MovePrintedCommand}" IsEnabled="{Binding HasFields}"
                                    ToolTip.Tip="{l:Tr Ui_MovePrintedTip}" x:Name="MovePrintedButton">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <c:Icon Data="{StaticResource I.Erase}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_MovePrinted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_MovePrintedNote}" Margin="0,0,0,6" />

                            <TextBlock Classes="section" Text="{l:Tr Ui_SectionEdit}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_EditKeys}" />

                            <TextBlock Classes="section" Text="{l:Tr Ui_SectionOutput}" />
                            <TextBlock Classes="caption" Text="{l:Tr Ui_FormLanguage}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.Languages}" SelectedItem="{Binding FormLanguage}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Classes="caption" Text="{l:Tr Ui_EmbedFontCaption}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding ClearFontCommand}"
                                        IsVisible="{Binding EmbedFontPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Padding="6" Margin="6,0,0,0" ToolTip.Tip="{l:Tr Ui_Remove}">
                                    <c:Icon Data="{StaticResource I.Close}" Size="14" />
                                </Button>
                                <Button Command="{Binding ChooseFontCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <c:Icon Data="{StaticResource I.Font}" Size="18" />
                                        <TextBlock Text="{Binding FontText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <TextBlock Classes="note" Text="{l:Tr Ui_EmbedFontNote}" Margin="0,6,0,0" />

                            <TextBlock Classes="section" Text="fields.json" />
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" Command="{Binding LoadFieldsCommand}" IsEnabled="{Binding HasDocument}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Content="{l:Tr Ui_LoadShort}" ToolTip.Tip="{l:Tr Ui_LoadFields}" />
                                <Button Grid.Column="2" Command="{Binding SaveFieldsCommand}" IsEnabled="{Binding HasDocument}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Content="{l:Tr Ui_SaveShort}" ToolTip.Tip="{l:Tr Ui_SaveFields}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- OCR -->
                <DockPanel IsVisible="{Binding IsOcrTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="note" Text="{Binding Ocr.Progress}" IsVisible="{Binding Busy}" HorizontalAlignment="Center" />
                            <Button Classes="accent primary" Command="{Binding Ocr.RunCommand}" IsEnabled="{Binding Ocr.CanRun}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Ocr}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_OcrRun}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_OcrTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_OcrLead}" />
                            <Border Background="{StaticResource MistBrush}" Padding="10,8" Margin="0,12,0,0" IsVisible="{Binding HasDocument}">
                                <TextBlock Classes="note" Text="{Binding Ocr.PlanText}" Foreground="{StaticResource InkBrush}" />
                            </Border>

                            <TextBlock Classes="section" Text="{l:Tr Ui_OcrEngine}" />
                            <ComboBox ItemsSource="{x:Static vm:OcrToolViewModel.Engines}" SelectedItem="{Binding Ocr.Engine}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_OcrEngineNote}" Margin="0,6,0,0" />

                            <TextBlock Classes="section" Text="{l:Tr Ui_OcrLanguages}" />
                            <ItemsControl ItemsSource="{Binding Ocr.Languages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <ToggleButton Classes="chip" Content="{Binding Text}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox Content="{l:Tr Ui_OcrForce}" IsChecked="{Binding Ocr.Force}" Margin="0,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Combine -->
                <DockPanel IsVisible="{Binding IsCombineTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <Button Classes="accent primary" Command="{Binding Combine.RunCommand}" IsEnabled="{Binding Combine.CanCombine}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource I.Combine}" Size="18" />
                                <TextBlock Text="{l:Tr Ui_CombineRun}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,0">
                        <TextBlock Classes="title" Text="{l:Tr Ui_CombineTitle}" />
                        <TextBlock Classes="lead" Text="{l:Tr Ui_CombineLead}" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,16,0,8">
                            <Button Grid.Column="0" Command="{Binding Combine.AddFilesCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Add}" Size="16" />
                                    <TextBlock Text="{l:Tr Ui_AddFiles}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding Combine.MoveUpCommand}" Padding="7" Margin="4,0,0,0" ToolTip.Tip="{l:Tr Ui_MoveUp}">
                                <c:Icon Data="{StaticResource I.ChevronUp}" Size="16" />
                            </Button>
                            <Button Grid.Column="2" Command="{Binding Combine.MoveDownCommand}" Padding="7" Margin="4,0,0,0" ToolTip.Tip="{l:Tr Ui_MoveDown}">
                                <c:Icon Data="{StaticResource I.ChevronDown}" Size="16" />
                            </Button>
                            <Button Grid.Column="3" Command="{Binding Combine.RemoveCommand}" Padding="7" Margin="4,0,0,0" ToolTip.Tip="{l:Tr Ui_Remove}">
                                <c:Icon Data="{StaticResource I.Delete}" Size="16" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,12" Spacing="4" IsVisible="{Binding Combine.HasImages}">
                        <TextBlock Classes="note" Text="{l:Tr Ui_ImagesPage}" />
                        <ComboBox SelectedIndex="{Binding Combine.PageSizeIndex}" HorizontalAlignment="Stretch" x:Name="CombinePageSize">
                            <ComboBoxItem Content="{l:Tr Ui_ImagesA4}" />
                            <ComboBoxItem Content="{l:Tr Ui_ImagesLetter}" />
                            <ComboBoxItem Content="{l:Tr Ui_ImagesOwnSize}" />
                        </ComboBox>
                    </StackPanel>
                    <Panel Margin="20,0,20,12">
                        <ListBox ItemsSource="{Binding Combine.Files}" SelectedItem="{Binding Combine.Selected}"
                                 BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CombineItem">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   Classes.warn="{Binding Protected}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="note" Text="{l:Tr Ui_CombineEmpty}" TextAlignment="Center" VerticalAlignment="Center" Margin="24"
                                   IsVisible="{Binding !Combine.Files.Count}" IsHitTestVisible="False" />
                    </Panel>
                </DockPanel>

                <!-- Split -->
                <DockPanel IsVisible="{Binding IsSplitTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <Button Classes="accent primary" Command="{Binding Split.RunCommand}" IsEnabled="{Binding Split.CanSplit}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource I.Split}" Size="18" />
                                <TextBlock Text="{l:Tr Ui_SplitRun}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Classes="title" Text="{l:Tr Ui_SplitTitle}" />
                        <TextBlock Classes="lead" Text="{l:Tr Ui_SplitLead}" />
                        <TextBlock Classes="section" Text="{l:Tr Ui_Ranges}" />
                        <TextBox Text="{Binding Split.Ranges}" PlaceholderText="1-3, 5" IsEnabled="{Binding HasDocument}" />
                        <TextBlock Classes="note" Text="{l:Tr Ui_RangesHint}" Margin="0,6,0,0" />
                        <Border Background="{StaticResource MistBrush}" Padding="10,8" Margin="0,14,0,0" IsVisible="{Binding HasDocument}">
                            <TextBlock Classes="note" Text="{Binding Split.Preview}" Foreground="{StaticResource InkBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Organize pages -->
                <DockPanel IsVisible="{Binding IsOrganizeTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <Button Classes="accent primary" Command="{Binding Organize.SaveCommand}" IsEnabled="{Binding Organize.CanSave}"
                                x:Name="OrganizeSaveButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource I.Save}" Size="18" />
                                <TextBlock Text="{l:Tr Ui_OrganizeRun}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,0">
                        <TextBlock Classes="title" Text="{l:Tr Ui_OrganizeTitle}" />
                        <TextBlock Classes="lead" Text="{l:Tr Ui_OrganizeLead}" />
                        <Button Command="{Binding Organize.InsertFilesCommand}" HorizontalAlignment="Left" Margin="0,16,0,8"
                                IsEnabled="{Binding HasDocument}" ToolTip.Tip="{l:Tr Ui_OrganizeInsertTip}" x:Name="OrganizeInsertButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource I.Add}" Size="16" />
                                <TextBlock Text="{l:Tr Ui_OrganizeInsert}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8" IsEnabled="{Binding HasDocument}">
                            <Button Command="{Binding Organize.RotateLeftCommand}" Padding="7" ToolTip.Tip="{l:Tr Ui_RotateLeft}">
                                <c:Icon Data="{StaticResource I.RotateLeft}" Size="16" />
                            </Button>
                            <Button Command="{Binding Organize.RotateRightCommand}" Padding="7" ToolTip.Tip="{l:Tr Ui_RotateRight}">
                                <c:Icon Data="{StaticResource I.RotateRight}" Size="16" />
                            </Button>
                            <Button Command="{Binding Organize.MoveUpCommand}" Padding="7" ToolTip.Tip="{l:Tr Ui_MoveUp}">
                                <c:Icon Data="{StaticResource I.Prev}" Size="16" />
                            </Button>
                            <Button Command="{Binding Organize.MoveDownCommand}" Padding="7" ToolTip.Tip="{l:Tr Ui_MoveDown}">
                                <c:Icon Data="{StaticResource I.Next}" Size="16" />
                            </Button>
                            <Button Command="{Binding Organize.RemoveCommand}" Padding="7" ToolTip.Tip="{l:Tr Ui_Remove}">
                                <c:Icon Data="{StaticResource I.Delete}" Size="16" />
                            </Button>
                        </StackPanel>
                        <DockPanel Margin="0,0,0,8" IsVisible="{Binding HasDocument}">
                            <Button DockPanel.Dock="Right" Content="{l:Tr Ui_OrganizeReset}" Command="{Binding Organize.ResetCommand}"
                                    IsVisible="{Binding Organize.Changed}" Padding="8,2" FontSize="12" />
                            <TextBlock Classes="note" Text="{Binding Organize.Summary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,8" Spacing="6" IsVisible="{Binding HasDocument}">
                        <TextBlock Classes="note" Text="{Binding Organize.ScopeText}" TextWrapping="Wrap" />
                        <Expander Header="{l:Tr Ui_CropTitle}" HorizontalAlignment="Stretch" x:Name="CropExpander">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,6,*,10,Auto,6,*" RowDefinitions="Auto,6,Auto" IsEnabled="{Binding !Organize.CropTrim}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr Ui_CropTop}" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding Organize.CropTop}" Minimum="0" Maximum="300" Increment="1" FormatString="0" />
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{l:Tr Ui_CropBottom}" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="6" Value="{Binding Organize.CropBottom}" Minimum="0" Maximum="300" Increment="1" FormatString="0" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Tr Ui_CropLeft}" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding Organize.CropLeft}" Minimum="0" Maximum="300" Increment="1" FormatString="0" />
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{l:Tr Ui_CropRight}" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="6" Value="{Binding Organize.CropRight}" Minimum="0" Maximum="300" Increment="1" FormatString="0" />
                                </Grid>
                                <TextBlock Classes="note" Text="{l:Tr Ui_CropMm}" />
                                <CheckBox IsChecked="{Binding Organize.CropTrim}" Content="{l:Tr Ui_CropTrim}" />
                                <Button Content="{l:Tr Ui_CropRun}" Command="{Binding Organize.CropCommand}" Padding="12,4" x:Name="CropButton" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="{l:Tr Ui_ExportTitle}" HorizontalAlignment="Stretch" x:Name="ExportExpander">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,8,*">
                                    <ComboBox Grid.Column="0" SelectedIndex="{Binding Organize.ExportFormatIndex}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="PNG" />
                                        <ComboBoxItem Content="JPEG" />
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" SelectedIndex="{Binding Organize.ExportDpiIndex}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="72 dpi" />
                                        <ComboBoxItem Content="150 dpi" />
                                        <ComboBoxItem Content="300 dpi" />
                                    </ComboBox>
                                </Grid>
                                <Button Content="{l:Tr Ui_ExportRun}" Command="{Binding Organize.ExportImagesCommand}" Padding="12,4" x:Name="ExportButton" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <Panel Margin="20,0,20,12">
                        <ListBox ItemsSource="{Binding Organize.Pages}" SelectedItems="{Binding Organize.Selected}" SelectionMode="Multiple"
                                 BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" x:Name="OrganizeList">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4,6" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.KeyBindings>
                                <KeyBinding Gesture="Delete" Command="{Binding Organize.RemoveCommand}" />
                                <KeyBinding Gesture="Back" Command="{Binding Organize.RemoveCommand}" />
                            </ListBox.KeyBindings>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OrganizeItem">
                                    <StackPanel Width="64" Spacing="2" ToolTip.Tip="{Binding Source}">
                                        <Panel Width="64" Height="64">
                                            <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center" LayoutTransform="{Binding Turn}">
                                                <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" Background="White">
                                                    <Image Source="{Binding Image}" MaxWidth="62" MaxHeight="62" Stretch="Uniform" />
                                                </Border>
                                            </LayoutTransformControl>
                                        </Panel>
                                        <TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Classes.inserted="{Binding Inserted}" />
                                        <TextBlock Text="{Binding RotateText}" FontSize="10" TextAlignment="Center" Foreground="{StaticResource BlueBrush}"
                                                   IsVisible="{Binding RotateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="note" Text="{l:Tr Ui_OrganizeEmpty}" TextAlignment="Center" VerticalAlignment="Center" Margin="24"
                                   IsVisible="{Binding !HasDocument}" IsHitTestVisible="False" />
                    </Panel>
                </DockPanel>

                <!-- Comment -->
                <DockPanel IsVisible="{Binding IsCommentTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <Button Classes="accent primary" Command="{Binding Comment.SaveCommand}" IsEnabled="{Binding Comment.CanSave}" x:Name="CommentSaveButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource I.Comment}" Size="18" />
                                <TextBlock Text="{l:Tr Ui_CommentRun}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_CommentTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_CommentLead}" />
                            <ListBox ItemsSource="{x:Static vm:CommentToolViewModel.Modes}" SelectedItem="{Binding Comment.SelectedMode}"
                                     Margin="0,14,0,0" Background="Transparent" x:Name="CommentModes">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="10,4" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CommentMode">
                                        <TextBlock Text="{Binding Text}" FontSize="12" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Classes="note" Text="{Binding Comment.Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <StackPanel IsVisible="{Binding Comment.NeedsText}">
                                <TextBlock Classes="caption" Text="{l:Tr Ui_CommentText}" />
                                <TextBox Text="{Binding Comment.Draft}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" x:Name="CommentDraftBox" />
                            </StackPanel>
                            <TextBlock Classes="caption" Text="{l:Tr Ui_CommentAuthor}" />
                            <TextBox Text="{Binding Comment.Author}" />
                            <TextBlock Classes="section" Text="{l:Tr Ui_CommentNew}" IsVisible="{Binding Comment.HasPending}" />
                            <ItemsControl ItemsSource="{Binding Comment.Pending}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PendingComment">
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Padding="5" ToolTip.Tip="{l:Tr Ui_Remove}"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Comment.RemovePendingCommand}" CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource I.Delete}" Size="14" />
                                            </Button>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="section" Text="{l:Tr Ui_CommentExisting}" IsVisible="{Binding Comment.Existing.Count}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_CommentExistingHint}" TextWrapping="Wrap" IsVisible="{Binding Comment.Existing.Count}" />
                            <ListBox ItemsSource="{Binding Comment.Existing}" SelectedItem="{Binding Comment.SelectedExisting}" Background="Transparent"
                                     x:Name="ExistingCommentList">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="6,3" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExistingComment">
                                        <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- the chosen comment: its words, colour, removal and replies -->
                            <Border IsVisible="{Binding Comment.HasSelectedExisting}" Background="{StaticResource MistBrush}" Padding="10,8" Margin="0,8,0,0"
                                    x:Name="ExistingCommentEditor">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Comment.SelectedExisting.Kind, FallbackValue={x:Null}}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Comment.SelectedExisting.Text, FallbackValue={x:Null}}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="48" IsEnabled="{Binding !Comment.SelectedExisting.Deleted, FallbackValue=False}" x:Name="ExistingCommentText" />
                                    <ItemsControl ItemsSource="{x:Static vm:CommentToolViewModel.Colors}"
                                                  IsVisible="{Binding Comment.SelectedExisting.Info.Redrawable, FallbackValue=False}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommentSwatch">
                                                <Button Width="22" Height="22" Padding="0" Background="{Binding Brush}" BorderBrush="#8d8d8d" BorderThickness="1"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Comment.SetColorCommand}"
                                                        CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="note" Text="{l:Tr Ui_CommentMoveHint}" TextWrapping="Wrap"
                                               IsVisible="{Binding Comment.SelectedExisting.Info.Movable, FallbackValue=False}" />
                                    <TextBlock Classes="note" Text="{Binding Comment.SelectedExisting.ThreadText, FallbackValue={x:Null}}" TextWrapping="Wrap"
                                               IsVisible="{Binding Comment.SelectedExisting.HasThread, FallbackValue=False}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{l:Tr Ui_CommentReply}" Command="{Binding Comment.ReplyCommand}" Padding="10,4"
                                                Margin="6,0,0,0" />
                                        <TextBox Text="{Binding Comment.ReplyDraft}" PlaceholderText="{l:Tr Ui_CommentReplyHint}" x:Name="CommentReplyBox" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="{l:Tr Ui_CommentDelete}" Command="{Binding Comment.ToggleDeleteCommand}" Padding="10,4" FontSize="12"
                                                x:Name="CommentDeleteButton" />
                                        <Button Content="{l:Tr Ui_CommentRevert}" Command="{Binding Comment.RevertCommand}" Padding="10,4" FontSize="12"
                                                IsVisible="{Binding Comment.SelectedExisting.IsChanged, FallbackValue=False}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Fill & Sign -->
                <DockPanel IsVisible="{Binding IsSignTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <Button Classes="accent primary" Command="{Binding Sign.SaveCommand}" IsEnabled="{Binding Sign.CanSave}" x:Name="SignSaveButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource I.Sign}" Size="18" />
                                <TextBlock Text="{l:Tr Ui_SignRun}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_SignTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_SignLead}" />
                            <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" Margin="0,14,0,0" Height="120">
                                <Panel>
                                    <c:InkPad Ink="{Binding Sign.Ink}" x:Name="SignPad" Cursor="Cross" />
                                    <TextBlock Classes="note" Text="{l:Tr Ui_SignPadHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !Sign.HasInk}" IsHitTestVisible="False" />
                                </Panel>
                            </Border>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="{l:Tr Ui_SignClear}" Command="{Binding Sign.ClearInkCommand}" Padding="10,3" FontSize="12" />
                                <CheckBox IsChecked="{Binding Sign.Remember}" Content="{l:Tr Ui_SignRemember}" FontSize="12" />
                            </DockPanel>
                            <TextBlock Classes="section" Text="{l:Tr Ui_SignSpots}" IsVisible="{Binding Sign.Spots.Count}" />
                            <ItemsControl ItemsSource="{Binding Sign.Spots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SignatureSpot">
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="{l:Tr Ui_SignHereButton}" Padding="8,2" FontSize="12"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Sign.SignSpotCommand}" CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="section" Text="{l:Tr Ui_SignPlacedTitle}" IsVisible="{Binding Sign.HasPlaced}" />
                            <ItemsControl ItemsSource="{Binding Sign.Placed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlacedSignature">
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Padding="5" ToolTip.Tip="{l:Tr Ui_Remove}"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Sign.RemovePlacedCommand}" CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource I.Delete}" Size="14" />
                                            </Button>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- signatures already in the file, checked -->
                            <TextBlock Classes="section" Text="{l:Tr Ui_SigInFile}" IsVisible="{Binding Sign.Digital.HasSignatures}" />
                            <ItemsControl ItemsSource="{Binding Sign.Digital.Signatures}" x:Name="SignatureChecks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SignatureRow">
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top"
                                                       Foreground="#B28600" Classes.ok="{Binding IsValid}" Classes.bad="{Binding IsInvalid}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Classes="note" Text="{Binding Details}" TextWrapping="Wrap"
                                                           IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Styles>
                                    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="#198038" /></Style>
                                    <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="#DA1E28" /></Style>
                                </ItemsControl.Styles>
                            </ItemsControl>

                            <!-- signing with a digital ID -->
                            <TextBlock Classes="section" Text="{l:Tr Ui_SigTitle}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_SigLead}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{l:Tr Ui_SigId}" />
                            <ComboBox ItemsSource="{Binding Sign.Digital.Ids}" SelectedItem="{Binding Sign.Digital.Id}" HorizontalAlignment="Stretch"
                                      IsVisible="{Binding !Sign.Digital.NoIds}" x:Name="DigitalIdBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="sig:DigitalId"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="note" Text="{l:Tr Ui_SigNoIds}" TextWrapping="Wrap" IsVisible="{Binding Sign.Digital.NoIds}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                <Button Content="{l:Tr Ui_SigOpenId}" Command="{Binding Sign.Digital.OpenIdFileCommand}" Padding="8,3" FontSize="12" />
                                <ToggleButton Content="{l:Tr Ui_SigCreateId}" IsChecked="{Binding Sign.Digital.Creating}" Padding="8,3" FontSize="12" x:Name="CreateIdToggle" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding Sign.Digital.HasIdFile}" Spacing="4" Margin="0,6,0,0">
                                <TextBlock Classes="caption" Text="{Binding Sign.Digital.IdFile}" TextTrimming="CharacterEllipsis" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Ui_ProtectOpen}" Command="{Binding Sign.Digital.UnlockIdFileCommand}" Padding="10,4" Margin="6,0,0,0" />
                                    <TextBox PasswordChar="•" Text="{Binding Sign.Digital.IdPassword}" PlaceholderText="{l:Tr Ui_ProtectPassword}" x:Name="IdPasswordBox" />
                                </DockPanel>
                            </StackPanel>
                            <Border IsVisible="{Binding Sign.Digital.Creating}" Background="{StaticResource MistBrush}" Padding="10,8" Margin="0,6,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_SigNewName}" />
                                    <TextBox Text="{Binding Sign.Digital.NewName}" x:Name="NewIdName" />
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_SigNewEmail}" />
                                    <TextBox Text="{Binding Sign.Digital.NewEmail}" />
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_SigNewPassword}" />
                                    <TextBox PasswordChar="•" Text="{Binding Sign.Digital.NewPassword}" />
                                    <TextBlock Classes="note" Text="{l:Tr Ui_SigNewNote}" TextWrapping="Wrap" />
                                    <Button Content="{l:Tr Ui_SigCreateSave}" Command="{Binding Sign.Digital.CreateIdCommand}" Padding="10,4" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="caption" Text="{l:Tr Ui_SigPlace}" />
                            <ComboBox ItemsSource="{Binding Sign.Digital.Places}" SelectedItem="{Binding Sign.Digital.Place}" HorizontalAlignment="Stretch" x:Name="SignPlaceBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SignPlace"><TextBlock Text="{Binding Text}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox IsChecked="{Binding Sign.Digital.IncludeInk}" Content="{l:Tr Ui_SigIncludeInk}" IsVisible="{Binding Sign.HasInk}" />
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_SigReason}" />
                                    <TextBox Text="{Binding Sign.Digital.Reason}" x:Name="SignReasonBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_SigLocation}" />
                                    <TextBox Text="{Binding Sign.Digital.Location}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="caption" Text="{l:Tr Ui_SigTimestamp}" />
                            <TextBox Text="{Binding Sign.Digital.TimestampServer}" PlaceholderText="https://…" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_SigTimestampNote}" TextWrapping="Wrap" />
                            <Button Classes="accent" Command="{Binding Sign.Digital.SignCommand}" IsEnabled="{Binding Sign.Digital.CanSign}" Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch" x:Name="DigitalSignButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Lock}" Size="16" />
                                    <TextBlock Text="{l:Tr Ui_SigSign}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Protect: passwords and hidden information -->
                <ScrollViewer IsVisible="{Binding IsProtectTool}">
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Classes="title" Text="{l:Tr Ui_ProtectTitle}" />
                        <TextBlock Classes="lead" Text="{l:Tr Ui_ProtectLead}" />

                        <!-- a file that needs its password to open -->
                        <StackPanel IsVisible="{Binding Protect.IsLocked}" Spacing="8" Margin="0,16,0,0">
                            <TextBlock Text="{Binding Protect.LockedText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBox PasswordChar="•" Text="{Binding Protect.UnlockPassword}" PlaceholderText="{l:Tr Ui_ProtectPassword}" x:Name="UnlockPasswordBox">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Protect.OpenLockedCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Classes="accent" Content="{l:Tr Ui_ProtectOpen}" Command="{Binding Protect.OpenLockedCommand}" x:Name="UnlockOpenButton" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_ProtectOpenNote}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasDocument}">
                            <!-- current protection -->
                            <TextBlock Classes="section" Text="{l:Tr Ui_ProtectStateTitle}" />
                            <TextBlock Text="{Binding Protect.StateText}" TextWrapping="Wrap" FontSize="12" x:Name="ProtectStateText" />
                            <TextBlock Text="{Binding Protect.PermissionsText}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                       IsVisible="{Binding Protect.PermissionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel IsVisible="{Binding Protect.IsEncrypted}" Spacing="6" Margin="0,8,0,0">
                                <TextBlock Classes="note" Text="{l:Tr Ui_ProtectCurrentPassword}" />
                                <TextBox PasswordChar="{Binding Protect.Mask}" Text="{Binding Protect.CurrentPassword}" />
                                <Button Content="{l:Tr Ui_ProtectRemove}" Command="{Binding Protect.RemoveProtectionCommand}" x:Name="RemoveProtectionButton" />
                            </StackPanel>

                            <!-- add a password -->
                            <TextBlock Classes="section" Text="{l:Tr Ui_ProtectAddTitle}" />
                            <StackPanel Spacing="6" IsEnabled="{Binding Protect.CanAdd}">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="note" Text="{l:Tr Ui_ProtectOpenPassword}" />
                                    <TextBox PasswordChar="{Binding Protect.Mask}" Text="{Binding Protect.OpenPassword}" x:Name="OpenPasswordBox" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding Protect.Restrict}" Content="{l:Tr Ui_ProtectRestrict}" x:Name="RestrictBox" />
                                <StackPanel IsVisible="{Binding Protect.Restrict}" Spacing="2" Margin="26,0,0,0">
                                    <TextBlock Classes="note" Text="{l:Tr Ui_ProtectPermissionsPassword}" Margin="0,0,0,1" />
                                    <TextBox PasswordChar="{Binding Protect.Mask}" Text="{Binding Protect.PermissionsPassword}" Margin="0,0,0,6" x:Name="PermissionsPasswordBox" />
                                    <TextBlock Classes="note" Text="{l:Tr Ui_ProtectAllow}" />
                                    <CheckBox IsChecked="{Binding Protect.AllowPrint}" Content="{l:Tr Ui_PermPrint}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding Protect.AllowCopy}" Content="{l:Tr Ui_PermCopy}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding Protect.AllowEdit}" Content="{l:Tr Ui_PermEdit}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding Protect.AllowComment}" Content="{l:Tr Ui_PermComment}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding Protect.AllowFill}" Content="{l:Tr Ui_PermFill}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding Protect.AllowAssemble}" Content="{l:Tr Ui_PermAssemble}" FontSize="12" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding Protect.ShowPasswords}" Content="{l:Tr Ui_ProtectShow}" FontSize="12" />
                                <Button Classes="accent" Command="{Binding Protect.ProtectCommand}" IsEnabled="{Binding Protect.CanProtect}" x:Name="ProtectButton">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:Icon Data="{StaticResource I.Lock}" Size="16" />
                                        <TextBlock Text="{l:Tr Ui_ProtectRun}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Classes="note" Text="{l:Tr Ui_ProtectRunNote}" />
                            </StackPanel>

                            <!-- hidden information -->
                            <TextBlock Classes="section" Text="{l:Tr Ui_HiddenTitle}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_HiddenLead}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_HiddenNothing}" IsVisible="{Binding Protect.NothingHidden}" Margin="0,6,0,0" />
                            <TextBlock Classes="note" Text="{Binding Protect.CleanBlockedText}" IsVisible="{Binding Protect.IsEncrypted}" Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding Protect.Hidden}" Margin="0,6,0,0" x:Name="HiddenList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HiddenChoice">
                                        <CheckBox IsChecked="{Binding Remove}" IsEnabled="{Binding CanChoose}" Margin="0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Classes="note" Text="{Binding Details}" IsVisible="{Binding HasDetails}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding Protect.CleanCommand}" IsEnabled="{Binding Protect.CanClean}" Margin="0,8,0,0" x:Name="CleanButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Erase}" Size="16" />
                                    <TextBlock Text="{l:Tr Ui_HiddenRun}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Erase printed content -->
                <DockPanel IsVisible="{Binding IsCompressTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding Compress.CompressCommand}" IsEnabled="{Binding Compress.CanCompress}" x:Name="CompressButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Compress}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_CompressRun}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_CompressRunNote}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18" Spacing="4">
                            <TextBlock Classes="title" Text="{l:Tr Ui_CompressTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_CompressLead}" />
                            <TextBlock Text="{Binding Compress.SizeText}" FontWeight="SemiBold" Margin="0,4,0,8" x:Name="CompressSize" />
                            <RadioButton GroupName="compress" IsChecked="{Binding Compress.Light}" Content="{l:Tr Ui_CompressLight}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_CompressLightNote}" Margin="28,0,0,6" TextWrapping="Wrap" />
                            <RadioButton GroupName="compress" IsChecked="{Binding Compress.Standard}" Content="{l:Tr Ui_CompressStandard}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_CompressStandardNote}" Margin="28,0,0,6" TextWrapping="Wrap" />
                            <RadioButton GroupName="compress" IsChecked="{Binding Compress.Strong}" Content="{l:Tr Ui_CompressStrong}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_CompressStrongNote}" Margin="28,0,0,6" TextWrapping="Wrap" />
                            <Border Background="{StaticResource MistBrush}" Padding="10,8" Margin="0,10,0,0"
                                    IsVisible="{Binding Compress.Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Compress.Result}" TextWrapping="Wrap" FontSize="12" x:Name="CompressResult" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsRedactTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding Redact.RedactCommand}" IsEnabled="{Binding Redact.CanRedact}" x:Name="RedactButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Redact}" Size="18" />
                                    <TextBlock Text="{Binding Redact.RunText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_RedactRunNote}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_RedactTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_RedactLead}" />

                            <TextBlock Classes="section" Text="{l:Tr Ui_RedactFindTitle}" />
                            <TextBox Text="{Binding Redact.Words}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                                     PlaceholderText="{l:Tr Ui_RedactWordsHint}" x:Name="RedactWordsBox" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_RedactPatterns}" Margin="0,8,0,2" />
                            <CheckBox IsChecked="{Binding Redact.Emails}" Content="{l:Tr Ui_RedactEmails}" x:Name="RedactEmailsBox" />
                            <CheckBox IsChecked="{Binding Redact.Phones}" Content="{l:Tr Ui_RedactPhones}" />
                            <CheckBox IsChecked="{Binding Redact.Numbers}" Content="{l:Tr Ui_RedactNumbers}" />
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding Redact.MatchCase}" Content="{l:Tr Ui_RedactMatchCase}" />
                                <CheckBox IsChecked="{Binding Redact.WholeWords}" Content="{l:Tr Ui_RedactWholeWords}" />
                            </StackPanel>
                            <Button Content="{l:Tr Ui_RedactFind}" Command="{Binding Redact.FindCommand}" IsEnabled="{Binding Redact.CanFind}"
                                    Padding="14,5" Margin="0,8,0,0" x:Name="RedactFindButton" />

                            <TextBlock Classes="note" Text="{Binding Redact.FoundText}" Foreground="{StaticResource InkBrush}" Margin="0,10,0,4"
                                       IsVisible="{Binding Redact.FoundText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" x:Name="RedactFoundText" />
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Redact.HasMatches}" Margin="0,0,0,4">
                                <Button Content="{l:Tr Ui_RedactAll}" Command="{Binding Redact.SelectAllCommand}" Padding="8,2" FontSize="12">
                                    <Button.CommandParameter><x:Boolean>True</x:Boolean></Button.CommandParameter>
                                </Button>
                                <Button Content="{l:Tr Ui_RedactNone}" Command="{Binding Redact.SelectAllCommand}" Padding="8,2" FontSize="12">
                                    <Button.CommandParameter><x:Boolean>False</x:Boolean></Button.CommandParameter>
                                </Button>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Redact.Matches}" x:Name="RedactMatchList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RedactChoice">
                                        <DockPanel Margin="0,0,0,4">
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Redact}" VerticalAlignment="Top" MinWidth="0" Margin="0,0,4,0" />
                                            <Button Background="Transparent" Padding="2,1" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Redact.ShowCommand}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Text="{Binding Context}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="section" Text="{l:Tr Ui_RedactAreasTitle}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_RedactNoAreas}" IsVisible="{Binding !Redact.HasAreas}" />
                            <ItemsControl ItemsSource="{Binding Redact.Areas}" x:Name="RedactAreaList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RedactBox">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Padding="6,2" Background="Transparent" ToolTip.Tip="{l:Tr Ui_Remove}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Redact.RemoveAreaCommand}"
                                                    CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource I.Close}" Size="12" />
                                            </Button>
                                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsEditTextTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding EditText.SaveCommand}" IsEnabled="{Binding EditText.CanSave}" x:Name="EditTextSaveButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.EditText}" Size="18" />
                                    <TextBlock Text="{Binding EditText.SaveText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_EditTextSaveNote}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_EditTextTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_EditTextLead}" />

                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12,0,0">
                                <RadioButton GroupName="editmode" Content="{l:Tr Ui_EditTextModeLines}" IsChecked="{Binding !EditText.ParagraphMode}" />
                                <RadioButton GroupName="editmode" Content="{l:Tr Ui_EditTextModeParagraphs}" IsChecked="{Binding EditText.ParagraphMode}"
                                             x:Name="EditTextParagraphMode" />
                            </StackPanel>
                            <TextBlock Classes="section" Text="{l:Tr Ui_EditTextLine}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_EditTextClick}" IsVisible="{Binding !EditText.HasSelection}" />
                            <StackPanel IsVisible="{Binding EditText.HasSelection}" Spacing="6">
                                <TextBox Text="{Binding EditText.Text}" TextWrapping="Wrap" AcceptsReturn="{Binding EditText.ParagraphMode}"
                                         MaxHeight="220" x:Name="EditTextBox">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Escape" Command="{Binding EditText.CancelCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{l:Tr Ui_EditTextKeep}" Command="{Binding EditText.CommitCommand}" Padding="12,4" x:Name="EditTextKeepButton" />
                                    <Button Content="{l:Tr Ui_Cancel}" Command="{Binding EditText.CancelCommand}" Padding="12,4" />
                                </StackPanel>
                                <TextBlock Classes="note" Text="{l:Tr Ui_EditTextKeys}" IsVisible="{Binding !EditText.ParagraphMode}" />
                                <TextBlock Classes="note" Text="{l:Tr Ui_EditTextKeysParagraph}" IsVisible="{Binding EditText.ParagraphMode}" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Classes="section" Text="{l:Tr Ui_EditTextFindTitle}" />
                            <TextBox Text="{Binding EditText.Find}" PlaceholderText="{l:Tr Ui_EditTextFindHint}" x:Name="EditTextFindBox" />
                            <TextBox Text="{Binding EditText.Replace}" PlaceholderText="{l:Tr Ui_EditTextReplaceHint}" Margin="0,6,0,0" x:Name="EditTextReplaceBox" />
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding EditText.MatchCase}" Content="{l:Tr Ui_RedactMatchCase}" />
                                <CheckBox IsChecked="{Binding EditText.WholeWords}" Content="{l:Tr Ui_RedactWholeWords}" />
                            </StackPanel>
                            <Button Content="{l:Tr Ui_EditTextReplaceAll}" Command="{Binding EditText.ReplaceAllCommand}" IsEnabled="{Binding EditText.CanReplace}"
                                    Padding="14,5" Margin="0,8,0,0" x:Name="EditTextReplaceButton" />

                            <TextBlock Classes="note" Text="{Binding EditText.Message}" Foreground="{StaticResource InkBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding EditText.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" x:Name="EditTextMessage" />

                            <TextBlock Classes="section" Text="{l:Tr Ui_EditTextChanges}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_EditTextNoChanges}" IsVisible="{Binding !EditText.HasPending}" />
                            <ItemsControl ItemsSource="{Binding EditText.Pending}" x:Name="EditTextPendingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PendingTextEdit">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Padding="6,2" Background="Transparent" ToolTip.Tip="{l:Tr Ui_Remove}" VerticalAlignment="Top"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditText.RemoveCommand}"
                                                    CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource I.Close}" Size="12" />
                                            </Button>
                                            <Button Background="Transparent" Padding="2,1" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditText.ShowCommand}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Text="{Binding Change}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsImagesTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding Images.SaveCommand}" IsEnabled="{Binding Images.CanSave}" x:Name="ImagesSaveButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Image}" Size="18" />
                                    <TextBlock Text="{Binding Images.SaveText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_ImagesSaveNote}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_ImagesTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_ImagesLead}" />
                            <Button Command="{Binding Images.ChooseToAddCommand}" IsEnabled="{Binding HasDocument}" Padding="12,5" Margin="0,12,0,0" x:Name="ImagesAddButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Add}" Size="16" />
                                    <TextBlock Text="{l:Tr Ui_ImagesAdd}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{Binding Images.PlacingText}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       IsVisible="{Binding Images.Placing}" />

                            <StackPanel IsVisible="{Binding Images.HasSelection}" Spacing="6" Margin="0,12,0,0">
                                <TextBlock Classes="section" Text="{l:Tr Ui_ImageSelected}" Margin="0" />
                                <TextBlock Text="{Binding Images.Selected.Where}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{l:Tr Ui_ImageReplace}" Command="{Binding Images.ReplaceCommand}" Padding="12,4" x:Name="ImageReplaceButton" />
                                    <Button Content="{l:Tr Ui_ImageRemove}" Command="{Binding Images.RemoveSelectedCommand}" Padding="12,4" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Classes="section" Text="{l:Tr Ui_ImagesOnPages}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_ImagesNone}" IsVisible="{Binding !Images.HasImages}" />
                            <ItemsControl ItemsSource="{Binding Images.Images}" x:Name="ImagesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImageRow">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Padding="6,2" Background="Transparent" ToolTip.Tip="{l:Tr Ui_ImageUndo}" VerticalAlignment="Top"
                                                    IsVisible="{Binding State, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Images.UndoCommand}" CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource I.Close}" Size="12" />
                                            </Button>
                                            <Button Background="Transparent" Padding="2,1" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Images.ShowCommand}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Where}" FontSize="12" />
                                                    <TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                               IsVisible="{Binding State, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Images.Added}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PendingImage">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Padding="6,2" Background="Transparent" ToolTip.Tip="{l:Tr Ui_Remove}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Images.UndoCommand}" CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource I.Close}" Size="12" />
                                            </Button>
                                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsStampTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding Stamp.SaveCommand}" IsEnabled="{Binding Stamp.CanSave}" x:Name="StampSaveButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Stamp}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_StampSave}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_StampSaveNote}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_StampTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_StampLead}" />
                            <Border IsVisible="{Binding Stamp.HasExisting}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="6"
                                    Padding="10,8" Margin="0,12,0,0" x:Name="StampExistingBox">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Stamp.ExistingText}" FontSize="12" TextWrapping="Wrap" />
                                    <CheckBox IsChecked="{Binding Stamp.ReplaceExisting}" Content="{l:Tr Ui_StampReplace}" FontSize="12" />
                                    <Button Content="{l:Tr Ui_StampRemove}" Command="{Binding Stamp.RemoveExistingCommand}" Padding="10,3" FontSize="12"
                                            x:Name="StampRemoveButton" />
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="section" Text="{l:Tr Ui_StampHeader}" />
                            <Grid ColumnDefinitions="*,4,*,4,*">
                                <TextBox Grid.Column="0" Text="{Binding Stamp.HeaderLeft}" PlaceholderText="{l:Tr Ui_StampLeft}" FontSize="12" x:Name="StampHeaderLeft" />
                                <TextBox Grid.Column="2" Text="{Binding Stamp.HeaderCenter}" PlaceholderText="{l:Tr Ui_StampCenter}" FontSize="12" />
                                <TextBox Grid.Column="4" Text="{Binding Stamp.HeaderRight}" PlaceholderText="{l:Tr Ui_StampRight}" FontSize="12" />
                            </Grid>
                            <TextBlock Classes="section" Text="{l:Tr Ui_StampFooter}" />
                            <Grid ColumnDefinitions="*,4,*,4,*">
                                <TextBox Grid.Column="0" Text="{Binding Stamp.FooterLeft}" PlaceholderText="{l:Tr Ui_StampLeft}" FontSize="12" />
                                <TextBox Grid.Column="2" Text="{Binding Stamp.FooterCenter}" PlaceholderText="{l:Tr Ui_StampCenter}" FontSize="12" x:Name="StampFooterCenter" />
                                <TextBox Grid.Column="4" Text="{Binding Stamp.FooterRight}" PlaceholderText="{l:Tr Ui_StampRight}" FontSize="12" />
                            </Grid>
                            <TextBlock Classes="note" Text="{l:Tr Ui_StampTokens}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                <Button Content="{l:Tr Ui_StampPageNumbers}" Command="{Binding Stamp.PageNumbersCommand}" Padding="10,3" FontSize="12" x:Name="StampPageNumbersButton" />
                                <Button Content="{l:Tr Ui_StampBates}" Command="{Binding Stamp.BatesCommand}" Padding="10,3" FontSize="12" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,6,Auto" Margin="0,10,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr Ui_StampSize}" VerticalAlignment="Center" FontSize="12" />
                                <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding Stamp.FontSize}" Minimum="4" Maximum="72" Increment="1" FormatString="0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Tr Ui_StampPages}" VerticalAlignment="Center" FontSize="12" />
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Stamp.Pages}" PlaceholderText="{l:Tr Ui_StampAllPages}" />
                            </Grid>

                            <StackPanel IsVisible="{Binding Stamp.UsesBates}" Spacing="6" Margin="0,8,0,0">
                                <TextBlock Classes="section" Text="{l:Tr Ui_StampBatesTitle}" />
                                <TextBox Text="{Binding Stamp.BatesPrefix}" PlaceholderText="{l:Tr Ui_StampBatesPrefix}" />
                                <Grid ColumnDefinitions="Auto,8,*,12,Auto,8,*">
                                    <TextBlock Grid.Column="0" Text="{l:Tr Ui_StampBatesStart}" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Column="2" Value="{Binding Stamp.BatesStart}" Minimum="0" Maximum="99999999" Increment="1" FormatString="0" />
                                    <TextBlock Grid.Column="4" Text="{l:Tr Ui_StampBatesDigits}" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Column="6" Value="{Binding Stamp.BatesDigits}" Minimum="1" Maximum="12" Increment="1" FormatString="0" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Classes="section" Text="{l:Tr Ui_StampWatermark}" />
                            <TextBox Text="{Binding Stamp.WatermarkText}" PlaceholderText="{l:Tr Ui_StampWatermarkHint}" x:Name="StampWatermarkBox" />
                            <Grid ColumnDefinitions="Auto,8,*,8,Auto" Margin="0,8,0,0">
                                <TextBlock Grid.Column="0" Text="{l:Tr Ui_StampOpacity}" VerticalAlignment="Center" FontSize="12" />
                                <Slider Grid.Column="2" Minimum="5" Maximum="100" Value="{Binding Stamp.WatermarkOpacity}" />
                                <TextBlock Grid.Column="4" Text="{Binding Stamp.OpacityText}" VerticalAlignment="Center" FontSize="12" MinWidth="34" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,8,*,12,*" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Text="{l:Tr Ui_StampAngle}" VerticalAlignment="Center" FontSize="12" />
                                <NumericUpDown Grid.Column="2" Value="{Binding Stamp.WatermarkAngle}" Minimum="-90" Maximum="90" Increment="15" FormatString="0" />
                                <ComboBox Grid.Column="4" SelectedIndex="{Binding Stamp.WatermarkColorIndex}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="{l:Tr Ui_StampGrey}" />
                                    <ComboBoxItem Content="{l:Tr Ui_StampRed}" />
                                    <ComboBoxItem Content="{l:Tr Ui_StampBlue}" />
                                </ComboBox>
                            </Grid>
                            <CheckBox IsChecked="{Binding Stamp.WatermarkBehind}" Content="{l:Tr Ui_StampBehind}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsLinksTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding Links.SaveCommand}" IsEnabled="{Binding Links.CanSave}" x:Name="LinksSaveButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Link}" Size="18" />
                                    <TextBlock Text="{Binding Links.SaveText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_LinksSaveNote}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_LinksTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_LinksLead}" />
                            <StackPanel IsVisible="{Binding Links.HasDraft}" Spacing="6" Margin="0,12,0,0">
                                <TextBlock Classes="section" Text="{l:Tr Ui_LinkNew}" Margin="0" />
                                <TextBox Text="{Binding Links.Target}" PlaceholderText="{l:Tr Ui_LinkTargetHint}" x:Name="LinkTargetBox">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding Links.KeepCommand}" />
                                        <KeyBinding Gesture="Escape" Command="{Binding Links.CancelCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{l:Tr Ui_EditTextKeep}" Command="{Binding Links.KeepCommand}" Padding="12,4" />
                                    <Button Content="{l:Tr Ui_Cancel}" Command="{Binding Links.CancelCommand}" Padding="12,4" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="{l:Tr Ui_LinksFind}" Command="{Binding Links.FindAddressesCommand}" IsEnabled="{Binding HasDocument}"
                                    Padding="12,5" Margin="0,12,0,0" x:Name="LinksFindButton" />
                            <TextBlock Classes="note" Text="{Binding Links.Message}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       IsVisible="{Binding Links.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Classes="section" Text="{l:Tr Ui_LinksNew}" IsVisible="{Binding Links.HasPending}" />
                            <ItemsControl ItemsSource="{Binding Links.Pending}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PendingLink">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Padding="6,2" Background="Transparent" ToolTip.Tip="{l:Tr Ui_Remove}" VerticalAlignment="Top"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Links.RemovePendingCommand}" CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource I.Close}" Size="12" />
                                            </Button>
                                            <Button Background="Transparent" Padding="2,1" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Links.ShowCommand}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Text="{Binding Target}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="section" Text="{l:Tr Ui_LinksExisting}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_LinksNone}" IsVisible="{Binding !Links.HasExisting}" />
                            <ItemsControl ItemsSource="{Binding Links.Existing}" x:Name="LinksExistingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LinkRow">
                                        <DockPanel Margin="0,0,0,4">
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Remove}" Content="{l:Tr Ui_LinkRemove}" FontSize="11" VerticalAlignment="Top" />
                                            <Button Background="Transparent" Padding="2,1" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Links.ShowCommand}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Text="{Binding Target}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsCompareTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding Compare.SaveCommand}" IsEnabled="{Binding Compare.CanSave}" x:Name="CompareSaveButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Compare}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_CompareSave}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_CompareSaveNote}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_CompareTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_CompareLead}" />
                            <Button Command="{Binding Compare.ChooseCommand}" Padding="12,5" Margin="0,12,0,0" x:Name="CompareChooseButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Open}" Size="16" />
                                    <TextBlock Text="{l:Tr Ui_CompareChoose}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Compare.OtherText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding Compare.HasOther}" />
                            <CheckBox IsChecked="{Binding Compare.OtherIsNewer}" Content="{l:Tr Ui_CompareOtherNewer}" IsVisible="{Binding Compare.HasOther}" />
                            <Button Content="{l:Tr Ui_CompareRun}" Command="{Binding Compare.CompareCommand}" IsEnabled="{Binding Compare.CanCompare}"
                                    Padding="14,5" Margin="0,8,0,0" x:Name="CompareRunButton" />

                            <TextBlock Classes="note" Text="{Binding Compare.Summary}" Foreground="{StaticResource InkBrush}" Margin="0,12,0,6" TextWrapping="Wrap"
                                       IsVisible="{Binding Compare.Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" x:Name="CompareSummary" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_CompareLegend}" IsVisible="{Binding Compare.HasRows}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Compare.Rows}" x:Name="CompareRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompareRow">
                                        <Button Background="Transparent" Padding="2,1" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Compare.ShowCommand}" CommandParameter="{Binding}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" FontWeight="Bold" Width="16" VerticalAlignment="Top" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsEraseTool}">
                    <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Button Classes="accent primary" Command="{Binding Erase.EraseCommand}" IsEnabled="{Binding Erase.CanErase}" x:Name="EraseButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource I.Erase}" Size="18" />
                                    <TextBlock Text="{l:Tr Ui_EraseRun}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{l:Tr Ui_EraseRunNote}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Classes="title" Text="{l:Tr Ui_EraseTitle}" />
                            <TextBlock Classes="lead" Text="{l:Tr Ui_EraseLead}" />

                            <TextBlock Classes="section" Text="{l:Tr Ui_EraseBoxes}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_EraseNoBoxes}" IsVisible="{Binding !Erase.HasBoxes}" />
                            <ItemsControl ItemsSource="{Binding Erase.Boxes}" x:Name="EraseBoxList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EraseBox">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Padding="6,2" Background="Transparent" ToolTip.Tip="{l:Tr Ui_Remove}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Erase.RemoveBoxCommand}"
                                                    CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource I.Close}" Size="12" />
                                            </Button>
                                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{l:Tr Ui_EraseClear}" Command="{Binding Erase.ClearCommand}" IsVisible="{Binding Erase.HasBoxes}"
                                    Padding="10,4" FontSize="12" Margin="0,4,0,0" />

                            <Border Background="{StaticResource MistBrush}" Padding="10,8" Margin="0,12,0,0" IsVisible="{Binding Erase.HasBoxes}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="note" Text="{Binding Erase.PlanText}" Foreground="{StaticResource InkBrush}" x:Name="ErasePlanText" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="12" Height="12" Background="#47DA1E28" VerticalAlignment="Center" />
                                        <TextBlock Classes="note" Text="{l:Tr Ui_EraseLegendRemove}" />
                                        <Border Width="12" Height="12" BorderBrush="#F1C21B" BorderThickness="1.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Classes="note" Text="{l:Tr Ui_EraseLegendKeep}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="section" Text="{l:Tr Ui_EraseOptions}" />
                            <CheckBox IsChecked="{Binding Erase.KeepColored}" Content="{l:Tr Ui_EraseKeepColored}" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_EraseKeepColoredNote}" Margin="28,0,0,6" />
                            <CheckBox IsChecked="{Binding Erase.Rules}" Content="{l:Tr Ui_EraseRules}" />
                            <CheckBox IsChecked="{Binding Erase.MakeEditable}" Content="{l:Tr Ui_EraseMakeEditable}" Margin="0,6,0,0"
                                      x:Name="EraseMakeEditable" />
                            <TextBlock Classes="note" Text="{l:Tr Ui_EraseMakeEditableNote}" Margin="28,0,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- AI assistant -->
                <Panel IsVisible="{Binding IsAskTool}">
                    <v:AssistantPanel DataContext="{Binding Assistant}" x:Name="AssistantView" />
                </Panel>
            </Panel>
        </Border>

        <!-- ============================================================ right rail -->
        <Border DockPanel.Dock="Right" Width="52" Background="{StaticResource MistBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding ShowRightRail}">
            <StackPanel Margin="0,8" Spacing="4" HorizontalAlignment="Center">
                <ToggleButton Classes="siderail" IsChecked="{Binding ShowFieldsPanel}" IsVisible="{Binding IsFormTool}"
                              ToolTip.Tip="{l:Tr Ui_FieldsPanel}" x:Name="FieldsPanelButton">
                    <c:Icon Data="{StaticResource I.Fields}" />
                </ToggleButton>
                <ToggleButton Classes="siderail" IsChecked="{Binding ShowPagesPanel}" ToolTip.Tip="{l:Tr Ui_PagesPanel}"
                              x:Name="PagesPanelButton">
                    <c:Icon Data="{StaticResource I.Pages}" />
                </ToggleButton>
                <ToggleButton Classes="siderail" IsChecked="{Binding ShowBookmarksPanel}" ToolTip.Tip="{l:Tr Ui_BookmarksPanel}"
                              x:Name="BookmarksPanelButton">
                    <c:Icon Data="{StaticResource I.Bookmark}" />
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- ============================================================ right panel -->
        <Border DockPanel.Dock="Right" Width="304" Background="White" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,0,0,0"
                IsVisible="{Binding ShowSidePanel}">
            <Panel>
                <!-- Fields: the selected field, then every field on the page -->
                <DockPanel IsVisible="{Binding ShowFieldsPanel}" Margin="16,16,16,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{l:Tr Ui_Field}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Classes="note" Text="{l:Tr Ui_NoSelection}" Margin="0,8,0,0" IsVisible="{Binding !HasSelection}" />
                        <StackPanel IsVisible="{Binding HasSelection}">
                            <!-- filling (Preview): the value; preparing the form: name, type, alignment -->
                            <StackPanel IsVisible="{Binding PreviewMode}">
                                <TextBlock Classes="caption" Text="{Binding SelectedField.Label}"
                                           IsVisible="{Binding SelectedField.Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                                <TextBlock Classes="caption" Text="{l:Tr Ui_Value}" />
                                <TextBox Text="{Binding SelectedField.Value}" IsVisible="{Binding SelectedField.IsTyped, FallbackValue=False}"
                                         TextWrapping="Wrap" x:Name="FieldValueBox" />
                                <TextBlock Text="{Binding SelectedField.Error, FallbackValue={x:Null}}" Foreground="#da1e28" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedField.HasError, FallbackValue=False}" x:Name="FieldErrorText" />
                                <TextBlock Classes="note" Text="{Binding SelectedField.Shown, StringFormat={}→ {0}, FallbackValue={x:Null}}"
                                           IsVisible="{Binding SelectedField.HasRules, FallbackValue=False}" />
                                <CheckBox IsChecked="{Binding SelectedField.Ticked}" Content="{l:Tr Ui_Ticked}"
                                          IsVisible="{Binding SelectedField.IsCheckbox, FallbackValue=False}" />
                                <ComboBox ItemsSource="{Binding SelectedField.OptionList, FallbackValue={x:Null}}" SelectedItem="{Binding SelectedField.Value}"
                                          IsVisible="{Binding SelectedField.IsChoice, FallbackValue=False}" HorizontalAlignment="Stretch" x:Name="FieldChoiceBox" />
                                <Button Content="{l:Tr Ui_ChooseOption}" Command="{Binding ChooseRadioCommand}" CommandParameter="{Binding SelectedField}"
                                        IsVisible="{Binding SelectedField.IsRadio, FallbackValue=False}" Padding="10,4" />
                                <TextBlock Classes="note" Text="{l:Tr Ui_SignHere}" TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedField.IsSignature, FallbackValue=False}" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsDesignMode}">
                            <TextBlock Classes="caption" Text="{l:Tr Ui_Name}" />
                            <TextBox Text="{Binding SelectedField.Name}" x:Name="FieldNameBox" />
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_Type}" />
                                    <ComboBox x:Name="KindBox" ItemsSource="{x:Static vm:MainViewModel.Kinds}" HorizontalAlignment="Stretch"
                                              SelectedValue="{Binding SelectedField.Kind}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_Align}" />
                                    <ComboBox x:Name="AlignBox" ItemsSource="{x:Static vm:MainViewModel.Alignments}" HorizontalAlignment="Stretch"
                                              SelectedValue="{Binding SelectedField.Align}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel IsVisible="{Binding SelectedField.IsComb, FallbackValue=False}">
                                <TextBlock Classes="caption" Text="{l:Tr Ui_Boxes}" />
                                <NumericUpDown Value="{Binding SelectedField.MaxLen}" Minimum="1" Maximum="64" Increment="1" FormatString="0" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding SelectedField.IsRadio, FallbackValue=False}">
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="caption" Text="{l:Tr Ui_RadioGroup}" />
                                        <TextBox Text="{Binding SelectedField.Group}" x:Name="FieldGroupBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="caption" Text="{l:Tr Ui_RadioExport}" />
                                        <TextBox Text="{Binding SelectedField.Export}" x:Name="FieldExportBox" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="note" Text="{l:Tr Ui_RadioGroupHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding SelectedField.IsChoice, FallbackValue=False}">
                                <TextBlock Classes="caption" Text="{l:Tr Ui_ChoiceOptions}" />
                                <TextBox Text="{Binding SelectedField.Options}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                         x:Name="FieldOptionsBox" />
                            </StackPanel>
                            <!-- rules: how the value is shown, what it accepts, how it is calculated (Acrobat's field actions) -->
                            <StackPanel IsVisible="{Binding SelectedField.IsTyped, FallbackValue=False}" x:Name="FieldRulesPanel">
                                <TextBlock Classes="caption" Text="{l:Tr Ui_FieldFormat}" />
                                <ComboBox x:Name="FormatBox" ItemsSource="{x:Static vm:MainViewModel.FormatKinds}" HorizontalAlignment="Stretch"
                                          SelectedValue="{Binding SelectedField.Format}" />
                                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding SelectedField.HasNumberFormat, FallbackValue=False}">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="caption" Text="{l:Tr Ui_FieldDecimals}" />
                                        <NumericUpDown Value="{Binding SelectedField.Decimals}" Minimum="0" Maximum="6" Increment="1" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" IsVisible="{Binding SelectedField.IsNumberFormat, FallbackValue=False}">
                                        <TextBlock Classes="caption" Text="{l:Tr Ui_FieldCurrency}" />
                                        <TextBox Text="{Binding SelectedField.Currency}" PlaceholderText="¥" x:Name="FieldCurrencyBox" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel IsVisible="{Binding SelectedField.HasPattern, FallbackValue=False}">
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_FieldPattern}" />
                                    <TextBox Text="{Binding SelectedField.Pattern}" x:Name="FieldPatternBox" />
                                    <TextBlock Classes="note" Text="{l:Tr Ui_FieldPatternHint}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="caption" Text="{l:Tr Ui_FieldMin}" />
                                        <TextBox Text="{Binding SelectedField.RangeMin}" x:Name="FieldMinBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="caption" Text="{l:Tr Ui_FieldMax}" />
                                        <TextBox Text="{Binding SelectedField.RangeMax}" x:Name="FieldMaxBox" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="caption" Text="{l:Tr Ui_FieldCalc}" />
                                <ComboBox x:Name="CalcBox" ItemsSource="{x:Static vm:MainViewModel.CalcOps}" HorizontalAlignment="Stretch"
                                          SelectedValue="{Binding SelectedField.CalcOp}" />
                                <StackPanel IsVisible="{Binding SelectedField.IsCalculated, FallbackValue=False}">
                                    <TextBlock Classes="caption" Text="{l:Tr Ui_FieldCalcSources}" />
                                    <TextBox Text="{Binding SelectedField.CalcSources}" TextWrapping="Wrap" x:Name="FieldCalcSourcesBox" />
                                    <TextBlock Classes="note" Text="{l:Tr Ui_FieldCalcHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding SelectedField.Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                                <TextBlock Classes="caption" Text="{l:Tr Ui_Label}" />
                                <TextBlock Text="{Binding SelectedField.Label}" TextWrapping="Wrap" />
                            </StackPanel>
                            </StackPanel>
                            <!-- how the value looks: fitted to the box unless a size is chosen -->
                            <StackPanel IsVisible="{Binding SelectedField.HasTextStyle, FallbackValue=False}" x:Name="TextStylePanel">
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="caption" Text="{l:Tr Ui_TextSize}" />
                                        <ComboBox x:Name="SizeBox" ItemsSource="{x:Static vm:MainViewModel.FontSizes}" HorizontalAlignment="Stretch"
                                                  SelectedValue="{Binding SelectedField.FontSize}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="caption" Text="{l:Tr Ui_TextColor}" />
                                        <ComboBox x:Name="ColorBox" ItemsSource="{x:Static vm:MainViewModel.TextColors}" HorizontalAlignment="Stretch"
                                                  SelectedValue="{Binding SelectedField.Color}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="caption" Text="{l:Tr Ui_TextFace}" />
                                <ComboBox x:Name="FaceBox" ItemsSource="{x:Static vm:MainViewModel.FontFaces}" HorizontalAlignment="Stretch"
                                          SelectedValue="{Binding SelectedField.Font}" />
                                <Button Content="{l:Tr Ui_StyleApplyAll}" Command="{Binding ApplyStyleToAllCommand}" Padding="10,4" FontSize="12"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding SelectedField.HasPrefilled, FallbackValue=False}">
                                <TextBlock Classes="caption" Text="{l:Tr Ui_Prefilled}" />
                                <TextBlock Text="{Binding SelectedField.PrefilledText}" TextWrapping="Wrap" Foreground="#da1e28" />
                                <Button Classes="action" Command="{Binding MovePrintedCommand}" CommandParameter="{Binding SelectedField}"
                                        Margin="0,8,0,0" x:Name="MovePrintedFieldButton">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <c:Icon Data="{StaticResource I.Erase}" Size="18" />
                                        <TextBlock Text="{l:Tr Ui_MovePrintedField}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Fill="{StaticResource RuleBrush}" Margin="0,16,0,8" />
                        <TextBlock Classes="caption" Text="{Binding ListCaption}" Margin="0,4,0,4" x:Name="FieldListCaption" />
                        <TextBlock Classes="note" Text="{Binding ListEmptyText}" IsVisible="{Binding ListEmpty}" Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- what is in each field (its value), else the form's own label, else the name -->
                    <ListBox ItemsSource="{Binding ListFields}" SelectedItem="{Binding SelectedField, Mode=OneWay}" x:Name="FieldList">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FieldViewModel">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Name}" IsVisible="{Binding ShowName}" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Bookmarks: the outline; a click opens its place; edit, then save a copy -->
                <DockPanel IsVisible="{Binding ShowBookmarksPanel}" Margin="16,16,16,12">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr Ui_BookmarksPanel}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,0,0,8">
                        <Button Command="{Binding Bookmarks.AddCommand}" ToolTip.Tip="{l:Tr Ui_BookmarkAdd}" Padding="6,4" x:Name="BookmarkAddButton">
                            <c:Icon Data="{StaticResource I.Add}" Size="16" />
                        </Button>
                        <Button Command="{Binding Bookmarks.RemoveCommand}" ToolTip.Tip="{l:Tr Ui_BookmarkRemove}" Padding="6,4">
                            <c:Icon Data="{StaticResource I.Delete}" Size="16" />
                        </Button>
                        <Rectangle Width="1" Fill="{StaticResource RuleBrush}" Margin="3,4" />
                        <Button Command="{Binding Bookmarks.UpCommand}" ToolTip.Tip="{l:Tr Ui_BookmarkUp}" Padding="6,4">
                            <c:Icon Data="{StaticResource I.ChevronUp}" Size="16" />
                        </Button>
                        <Button Command="{Binding Bookmarks.DownCommand}" ToolTip.Tip="{l:Tr Ui_BookmarkDown}" Padding="6,4">
                            <c:Icon Data="{StaticResource I.ChevronDown}" Size="16" />
                        </Button>
                        <Button Command="{Binding Bookmarks.OutdentCommand}" ToolTip.Tip="{l:Tr Ui_BookmarkOutdent}" Padding="6,4">
                            <c:Icon Data="{StaticResource I.Outdent}" Size="16" />
                        </Button>
                        <Button Command="{Binding Bookmarks.IndentCommand}" ToolTip.Tip="{l:Tr Ui_BookmarkIndent}" Padding="6,4">
                            <c:Icon Data="{StaticResource I.Indent}" Size="16" />
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding Bookmarks.CanSave}">
                        <Button Classes="accent" Command="{Binding Bookmarks.SaveCommand}" HorizontalAlignment="Stretch" x:Name="BookmarksSaveButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource I.Save}" Size="16" />
                                <TextBlock Text="{l:Tr Ui_BookmarksSave}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Classes="note" Text="{l:Tr Ui_BookmarksSaveNote}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0" IsVisible="{Binding Bookmarks.HasSelection}">
                        <TextBlock Classes="note" Text="{l:Tr Ui_BookmarkTitle}" />
                        <TextBox Text="{Binding Bookmarks.Selected.Title}" x:Name="BookmarkTitleBox" />
                        <Button Content="{l:Tr Ui_BookmarkUseThisPage}" Command="{Binding Bookmarks.UseThisPageCommand}" Padding="8,3" FontSize="12" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="note" Text="{l:Tr Ui_BookmarksNone}" TextWrapping="Wrap" IsVisible="{Binding Bookmarks.IsEmpty}" />
                    <TextBlock DockPanel.Dock="Top" Classes="note" Text="{Binding Bookmarks.Note}" TextWrapping="Wrap"
                               IsVisible="{Binding Bookmarks.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ListBox ItemsSource="{Binding Bookmarks.Rows}" SelectedItem="{Binding Bookmarks.Selected}" x:Name="BookmarkList"
                             Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookmarkRow">
                                <DockPanel Margin="{Binding Indent}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Pages -->
                <DockPanel IsVisible="{Binding ShowPagesPanel}" Margin="16,16,16,12">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr Ui_PagesPanel}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Thumbnails}" x:Name="ThumbList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PageThumb">
                                    <Button Click="OnThumbnailClick" Background="Transparent" Padding="6" Margin="0,0,4,4" Width="128">
                                        <StackPanel Spacing="4">
                                            <Border Classes.current="{Binding IsCurrent}" BorderThickness="2" BorderBrush="Transparent" Background="White"
                                                    BoxShadow="0 1 3 0 #26000000" Height="120">
                                                <Image Source="{Binding Image}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Styles>
                                <Style Selector="Border.current">
                                    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                                </Style>
                            </ItemsControl.Styles>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Panel>
        </Border>

        <Panel>
        <!-- ============================================================ settings (a page, not a window) -->
        <v:SettingsView IsVisible="{Binding IsSettingsTool}" x:Name="SettingsPage" />

        <!-- ============================================================ document -->
        <Panel Background="{StaticResource CanvasBrush}" x:Name="DocumentArea" IsVisible="{Binding IsDocumentView}">
            <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasDocument}">
                <Border Margin="56,56,56,96" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White"
                        BoxShadow="0 2 10 0 #33000000">
                    <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                        <c:FieldCanvas x:Name="Canvas" Editor="{Binding}" Zoom="{Binding Zoom}" />
                        <!-- Preview: the inline editor, placed over the field being typed into -->
                        <TextBox x:Name="FieldEditor" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 MinHeight="0" MinWidth="0" Padding="2,0" VerticalContentAlignment="Center"
                                 Background="White" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1.5" CornerRadius="0"
                                 AcceptsReturn="False" Foreground="{StaticResource InkBrush}" />
                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- empty state: open or drop -->
            <Border IsVisible="{Binding !HasDocument}" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                    BorderBrush="#c6c6c6" BorderThickness="1" Padding="56,44" x:Name="DropZone">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                        <Canvas Width="512" Height="512">
                            <Path Data="M0,0 H512 V512 H0 Z" Fill="{StaticResource WashiBlue}" />
                            <Path Data="M96,64 H320 L416,160 V448 H96 Z" Fill="White" />
                            <Path Data="M320,64 V160 H416 Z" Fill="#b1bff4" />
                            <Path Data="M144,224 h96 v80 h-96 Z M272,224 h96 v80 h-96 Z M144,336 h96 v80 h-96 Z" Fill="{StaticResource WashiBlue}" />
                            <Path Data="M272,336 h96 v80 h-96 Z" Fill="{StaticResource Vermilion}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{l:Tr Ui_DropTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="note" Text="{l:Tr Ui_DropLead}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" />
                    <Button Classes="accent" Command="{Binding OpenCommand}" HorizontalAlignment="Center" Padding="20,9" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Icon Data="{StaticResource I.Open}" Size="18" />
                            <TextBlock Text="{l:Tr Ui_Open}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- floating edit tools (form tool) -->
            <Border Classes="float" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" IsVisible="{Binding ShowEditTools}">
                <StackPanel Spacing="2">
                    <ToggleButton IsChecked="{Binding IsSelectMode, Mode=OneWay}" Command="{Binding SelectModeCommand}" ToolTip.Tip="{l:Tr Ui_SelectTip}"
                                  x:Name="SelectToolButton">
                        <c:Icon Data="{StaticResource I.Select}" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding DrawMode}" ToolTip.Tip="{l:Tr Ui_DrawTip}" x:Name="DrawToolButton">
                        <c:Icon Data="{StaticResource I.Draw}" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding PreviewMode}" ToolTip.Tip="{l:Tr Ui_PreviewTip}" x:Name="PreviewToolButton">
                        <c:Icon Data="{StaticResource I.Preview}" />
                    </ToggleButton>
                    <Rectangle Height="1" Fill="{StaticResource RuleBrush}" Margin="6,2" />
                    <Button Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:Tr Ui_DeleteTip}">
                        <c:Icon Data="{StaticResource I.Delete}" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- find bar (⌘/Ctrl+F), over the page in every tool -->
            <Border Classes="float" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Padding="6,4"
                    IsVisible="{Binding Find.IsOpen}" x:Name="FindBar">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <c:Icon Data="{StaticResource I.Search}" Size="16" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <TextBox Text="{Binding Find.Query}" Width="200" PlaceholderText="{l:Tr Ui_FindHint}" VerticalContentAlignment="Center"
                             x:Name="FindBox" />
                    <TextBlock Text="{Binding Find.CountText}" VerticalAlignment="Center" MinWidth="56" TextAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" x:Name="FindCount" />
                    <Button Command="{Binding Find.PreviousCommand}" IsEnabled="{Binding Find.HasHits}" ToolTip.Tip="{l:Tr Ui_FindPrevious}">
                        <c:Icon Data="{StaticResource I.ChevronUp}" Size="16" />
                    </Button>
                    <Button Command="{Binding Find.NextCommand}" IsEnabled="{Binding Find.HasHits}" ToolTip.Tip="{l:Tr Ui_FindNext}">
                        <c:Icon Data="{StaticResource I.ChevronDown}" Size="16" />
                    </Button>
                    <ToggleButton IsChecked="{Binding Find.MatchCase}" ToolTip.Tip="{l:Tr Ui_RedactMatchCase}" Padding="6,2">
                        <TextBlock Text="Aa" FontSize="12" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding Find.WholeWords}" ToolTip.Tip="{l:Tr Ui_RedactWholeWords}" Padding="6,2">
                        <TextBlock Text="ab|" FontSize="12" />
                    </ToggleButton>
                    <Button Command="{Binding Find.CloseCommand}" ToolTip.Tip="{l:Tr Ui_Close}">
                        <c:Icon Data="{StaticResource I.Close}" Size="14" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- floating page and zoom controls -->
            <Border Classes="float" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" IsVisible="{Binding HasDocument}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Command="{Binding PreviousPageCommand}" ToolTip.Tip="{l:Tr Ui_PrevPage}"><c:Icon Data="{StaticResource I.Prev}" Size="18" /></Button>
                    <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" MinWidth="78" TextAlignment="Center" FontSize="13" />
                    <Button Command="{Binding NextPageCommand}" ToolTip.Tip="{l:Tr Ui_NextPage}"><c:Icon Data="{StaticResource I.Next}" Size="18" /></Button>
                    <Rectangle Width="1" Fill="{StaticResource RuleBrush}" Margin="4,6" />
                    <Button Command="{Binding ZoomOutCommand}" ToolTip.Tip="{l:Tr Ui_ZoomOut}"><c:Icon Data="{StaticResource I.ZoomOut}" Size="18" /></Button>
                    <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="50" TextAlignment="Center" FontSize="13" />
                    <Button Command="{Binding ZoomInCommand}" ToolTip.Tip="{l:Tr Ui_ZoomIn}"><c:Icon Data="{StaticResource I.ZoomIn}" Size="18" /></Button>
                    <Button Command="{Binding FitWidthCommand}" ToolTip.Tip="{l:Tr Ui_FitWidth}"><c:Icon Data="{StaticResource I.FitWidth}" Size="18" /></Button>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============================================================ print (a card over the page) -->
        <Border Background="#66000000" IsVisible="{Binding Print.IsOpen}" x:Name="PrintOverlay">
            <Border Background="White" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18"
                    BoxShadow="0 4 24 0 #55000000" BorderBrush="{StaticResource BlueBrush}" BorderThickness="0,3,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:Tr Ui_PrintTitle}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Classes="note" Text="{Binding Print.Note}" TextWrapping="Wrap" />
                    <TextBlock Classes="note" Text="{l:Tr Ui_PrintPrinter}" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding Print.Printers}" SelectedItem="{Binding Print.Printer}" HorizontalAlignment="Stretch"
                              IsEnabled="{Binding !Print.NoPrinters}" x:Name="PrinterBox">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="print:PrinterInfo">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <TextBlock Text="{l:Tr Ui_PrintCopies}" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Print.Copies}" Minimum="1" Maximum="999" Increment="1" FormatString="0" Width="120"
                                       x:Name="PrintCopiesBox" />
                    </StackPanel>
                    <TextBlock Classes="note" Text="{l:Tr Ui_PrintPages}" Margin="0,4,0,0" />
                    <RadioButton GroupName="printpages" IsChecked="{Binding Print.AllPages}" Content="{l:Tr Ui_PrintAll}" />
                    <RadioButton GroupName="printpages" IsChecked="{Binding Print.CurrentPage}" Content="{Binding Print.CurrentPageText}" />
                    <DockPanel>
                        <RadioButton GroupName="printpages" IsChecked="{Binding Print.SomePages}" Content="{l:Tr Ui_PrintSome}" />
                        <TextBox Text="{Binding Print.Range}" PlaceholderText="1-3, 5" Margin="8,0,0,0" IsEnabled="{Binding Print.SomePages}"
                                 x:Name="PrintRangeBox" />
                    </DockPanel>
                    <CheckBox IsChecked="{Binding Print.TwoSided}" Content="{l:Tr Ui_PrintTwoSided}" Margin="0,4,0,0" />
                    <CheckBox IsChecked="{Binding Print.Grayscale}" Content="{l:Tr Ui_PrintGray}" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <RadioButton GroupName="printsize" IsChecked="{Binding Print.FitToPage}" Content="{l:Tr Ui_PrintFit}" />
                        <RadioButton GroupName="printsize" IsChecked="{Binding Print.ActualSize}" Content="{l:Tr Ui_PrintActual}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Print.Error}" Foreground="#da1e28" TextWrapping="Wrap" FontSize="12"
                               IsVisible="{Binding Print.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" x:Name="PrintError" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{l:Tr Ui_Cancel}" Command="{Binding Print.CancelCommand}" Padding="16,6" />
                        <Button Classes="accent" Command="{Binding Print.PrintCommand}" IsEnabled="{Binding Print.CanPrint}" Padding="16,6"
                                x:Name="PrintRunButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource I.Print}" Size="16" />
                                <TextBlock Text="{l:Tr Ui_PrintRun}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================================================ MCP approvals (cards, not modal windows) -->
        <ItemsControl ItemsSource="{Binding McpApprovals}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Width="360"
                      x:Name="ApprovalCards">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:ApprovalViewModel">
                    <Border Background="White" BorderBrush="{StaticResource BlueBrush}" BorderThickness="0,3,0,0" Padding="14,12"
                            Margin="0,0,0,10" BoxShadow="0 2 10 0 #40000000">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Summary}" FontFamily="Menlo, Consolas, monospace" FontSize="12" TextWrapping="Wrap" />
                            <Expander Header="{l:Tr Ui_ApprovalDetails}" Padding="6" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <SelectableTextBlock Text="{Binding Details}" FontFamily="Menlo, Consolas, monospace" FontSize="11" TextWrapping="Wrap" MaxHeight="200" />
                            </Expander>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="{l:Tr Ui_ApprovalDeny}" Command="{Binding DenyCommand}" />
                                <Button Classes="accent" Content="{l:Tr Ui_ApprovalAllow}" Command="{Binding ApproveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Panel>
    </DockPanel>
</Window>