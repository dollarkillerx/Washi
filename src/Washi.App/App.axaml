        <StreamGeometry x:Key="I.Search">M8.5,3 C11.6,3 14,5.4 14,8.5 C14,11.6 11.6,14 8.5,14 C5.4,14 3,11.6 3,8.5 C3,5.4 5.4,3 8.5,3 Z M12.5,12.5 L17,17</StreamGeometry>
        <StreamGeometry x:Key="I.ChevronUp">M4,13 L10,7 L16,13</StreamGeometry>
