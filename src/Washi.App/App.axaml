        <StreamGeometry x:Key="I.Down">M10,4 L10,16 M5,11 L10,16 L15,11</StreamGeometry>
        <StreamGeometry x:Key="I.ChevronDown">M4,7 L10,13 L16,7</StreamGeometry>
        <StreamGeometry x:Key="I.ZoomIn">M4,10 L16,10 M10,4 L10,16</StreamGeometry>
        <StreamGeometry x:Key="I.ZoomOut">M4,10 L16,10</StreamGeometry>
        <StreamGeometry x:Key="I.FitWidth">M2,4 L2,16 M18,4 L18,16 M5,10 L15,10 M8,7 L5,10 L8,13 M12,7 L15,10 L12,13</StreamGeometry>
        <StreamGeometry x:Key="I.Pages">M3,3 L9,3 L9,9 L3,9 Z M11,3 L17,3 L17,9 L11,9 Z M3,11 L9,11 L9,17 L3,17 Z M11,11 L17,11 L17,17 L11,17 Z</StreamGeometry>
        <StreamGeometry x:Key="I.Fields">M3,4 L17,4 L17,8 L3,8 Z M3,12 L17,12 L17,16 L3,16 Z M5,6 L9,6 M5,14 L9,14</StreamGeometry>
        <StreamGeometry x:Key="I.Close">M5,5 L15,15 M15,5 L5,15</StreamGeometry>
        <StreamGeometry x:Key="I.Add">M10,4 L10,16 M4,10 L16,10</StreamGeometry>
        <StreamGeometry x:Key="I.Save">M10,3 L10,13 M6,9 L10,13 L14,9 M3,14 L3,17 L17,17 L17,14</StreamGeometry>
        <StreamGeometry x:Key="I.Spark">M10,2 L11.6,8.4 L18,10 L11.6,11.6 L10,18 L8.4,11.6 L2,10 L8.4,8.4 Z</StreamGeometry>
        <StreamGeometry x:Key="I.Detect">M2,6 L2,2 L6,2 M14,2 L18,2 L18,6 M18,14 L18,18 L14,18 M6,18 L2,18 L2,14 M6,7 L14,7 L14,13 L6,13 Z</StreamGeometry>
        <StreamGeometry x:Key="I.Font">M4,17 L9,3 L11,3 L16,17 M6,12 L14,12</StreamGeometry>
