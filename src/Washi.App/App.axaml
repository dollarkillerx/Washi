        <StreamGeometry x:Key="I.Link">M8.5,11.5 L11.5,8.5 M9,6 L11,4 C12.5,2.5 15,2.5 16.5,4 C18,5.5 18,8 16.5,9.5 L14,12 M11,14 L9,16 C7.5,17.5 5,17.5 3.5,16 C2,14.5 2,12 3.5,10.5 L6,8</StreamGeometry>
        <StreamGeometry x:Key="I.Redact">M3,5 L17,5 M3,10 L6,10 M3,15 L11,15 M8,8 L17,8 L17,12 L8,12 Z M13,13 L17,13 L17,17 L13,17 Z</StreamGeometry>
