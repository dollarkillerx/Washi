<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Washi.App.Localization"
             x:Class="Washi.App.App"
             Name="Washi"
             RequestedThemeVariant="Light">
    <!-- Light only for now: the editor uses light surfaces; a dark palette is future work. -->

    <!-- macOS application menu (Washi ▸ About Washi, Settings…) -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{l:Tr Ui_About}" Click="OnAboutClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{l:Tr Ui_SettingsMenu}" Gesture="Cmd+OemComma" Click="OnSettingsClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <!-- brand palette (assets/brand/README.md) -->
        <Color x:Key="WashiBlue">#1f49e0</Color>
        <Color x:Key="WashiBlueOnDark">#4f7bff</Color>
        <Color x:Key="Vermilion">#e0452b</Color>
        <Color x:Key="Ink">#161616</Color>
        <SolidColorBrush x:Key="InkBrush" Color="#161616" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1f49e0" />
        <SolidColorBrush x:Key="MistBrush" Color="#f4f4f4" />
        <SolidColorBrush x:Key="RuleBrush" Color="#e0e0e0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6f6f6f" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#e8e8e8" />
        <SolidColorBrush x:Key="SelectedRailBrush" Color="#e5ebfc" />
        <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>

        <!-- icons: 20 × 20 strokes, drawn by Controls/Icon -->
        <StreamGeometry x:Key="I.Open">M2,5 L8,5 L10,7 L18,7 L18,16 L2,16 Z</StreamGeometry>
        <StreamGeometry x:Key="I.Form">M3,2 L17,2 L17,18 L3,18 Z M6,6 L14,6 L14,9 L6,9 Z M6,12 L9,12 L9,15 L6,15 Z M11,12 L14,12 L14,15 L11,15 Z</StreamGeometry>
        <StreamGeometry x:Key="I.Ocr">M2,6 L2,2 L6,2 M14,2 L18,2 L18,6 M18,14 L18,18 L14,18 M6,18 L2,18 L2,14 M6,6 L14,6 M10,6 L10,14</StreamGeometry>
        <StreamGeometry x:Key="I.Combine">M2,3 L8,3 L8,11 L2,11 Z M12,9 L18,9 L18,17 L12,17 Z M8,7 L11,7 L11,9 M12,13 L9,13 L9,11</StreamGeometry>
        <StreamGeometry x:Key="I.Refresh">M16,10 A6,6 0 1 1 13.5,5.1 M13,2 L14,5.5 L10.5,6.5</StreamGeometry>
        <StreamGeometry x:Key="I.Erase">M11,3 L17,9 L9,17 L5,17 L3,15 Z M7,7 L13,13 M9,17 L18,17</StreamGeometry>
        <StreamGeometry x:Key="I.Organize">M2,3 L8,3 L8,11 L2,11 Z M12,9 L18,9 L18,17 L12,17 Z M11,4 L15,4 L15,7 M13.5,5.5 L15,7 L16.5,5.5 M9,16 L5,16 L5,13 M3.5,14.5 L5,13 L6.5,14.5</StreamGeometry>
        <StreamGeometry x:Key="I.RotateRight">M6,9 L14,9 L14,18 L6,18 Z M4.5,6.5 A6,6 0 0 1 14.5,4.5 M15,1.5 L14.8,4.8 L11.6,4.6</StreamGeometry>
        <StreamGeometry x:Key="I.RotateLeft">M6,9 L14,9 L14,18 L6,18 Z M15.5,6.5 A6,6 0 0 0 5.5,4.5 M5,1.5 L5.2,4.8 L8.4,4.6</StreamGeometry>
        <StreamGeometry x:Key="I.Sign">M2,15 C4,9 6,8 7,11 C8,14 9,15 11,9 C12,7 13,12 15,12 L18,12 M2,18 L18,18</StreamGeometry>
        <StreamGeometry x:Key="I.EditText">M3,4 L12,4 M7.5,4 L7.5,16 M15.5,3 L15.5,17 M13.5,3 L17.5,3 M13.5,17 L17.5,17</StreamGeometry>
