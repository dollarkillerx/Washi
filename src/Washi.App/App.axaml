        <StreamGeometry x:Key="I.Comment">M3,3 L17,3 L17,13 L9,13 L5,17 L5,13 L3,13 Z M6,7 L14,7 M6,10 L11,10</StreamGeometry>
        <StreamGeometry x:Key="I.Split">M4,2 L16,2 L16,8 L4,8 Z M4,12 L16,12 L16,18 L4,18 Z M1,10 L3,10 M6,10 L8,10 M12,10 L14,10 M17,10 L19,10</StreamGeometry>
        <StreamGeometry x:Key="I.Ask">M3,3 L17,3 L17,13 L9,13 L5,17 L5,13 L3,13 Z M7,8 L7,8.5 M10,8 L10,8.5 M13,8 L13,8.5</StreamGeometry>
        <StreamGeometry x:Key="I.Select">M5,3 L5,16 L8.5,12.5 L11,18 L13,17 L10.5,11.5 L15,11.5 Z</StreamGeometry>
        <StreamGeometry x:Key="I.Draw">M2,6 L12,6 L12,14 L2,14 Z M16,3 L16,9 M13,6 L19,6</StreamGeometry>
        <StreamGeometry x:Key="I.Delete">M3,5 L17,5 M8,5 L8,3 L12,3 L12,5 M5,5 L6,17 L14,17 L15,5 M8.5,8 L8.5,14 M11.5,8 L11.5,14</StreamGeometry>
        <StreamGeometry x:Key="I.Prev">M12,4 L6,10 L12,16</StreamGeometry>
        <StreamGeometry x:Key="I.Next">M8,4 L14,10 L8,16</StreamGeometry>
        <StreamGeometry x:Key="I.Compress">M5,3 L15,3 L15,17 L5,17 Z M8,6 L10,8 L12,6 M8,14 L10,12 L12,14 M7.5,10 L12.5,10</StreamGeometry>
