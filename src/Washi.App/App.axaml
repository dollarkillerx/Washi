        <StreamGeometry x:Key="I.Preview">M3,3 L17,3 L17,17 L3,17 Z M6,8 L9,8 M6,12 L8,12 M10.5,12.5 L12,14 L15,10</StreamGeometry>
        <StreamGeometry x:Key="I.Json">M7,3 L5,3 L5,8 L3,10 L5,12 L5,17 L7,17 M13,3 L15,3 L15,8 L17,10 L15,12 L15,17 L13,17</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#1f49e0" RegionColor="#ffffff" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>
