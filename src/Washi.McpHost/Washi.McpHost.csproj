<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop app's MCP server: Streamable HTTP (in-process Kestrel, loopback only, bearer token) and a local
       socket / named pipe for the washi-mcp stdio bridge. A thin transport over Washi.Tools (IToolInvoker). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- LibraryImport (getpeereid / geteuid) generates unsafe marshalling stubs -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Washi.Tools\Washi.Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.NET.Sdk (not .Web): add the ASP.NET Core / hosting usings ourselves -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Washi.App.Tests" />
  </ItemGroup>
</Project>
